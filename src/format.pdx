// src/format.pdx — mkfs.pdxfs.M2-002/M2-003 (#5, #6) — the real,
// file-target-only write pipeline.
//
// This is the first file in this repo to perform a REAL write: given a
// TARGET_FILE target (src/target.pdx's classification), it creates or
// truncates the target, writes a fresh PDXB v1 superblock (via
// libpdx-volume's `pdxb_encode_superblock`), zeroes the inode-table
// region except for a real root-directory inode at slot 1, zeroes the
// allocator bitmap, zeroes the journal ring, and closes. The
// non-blank refusal gate (src/refusal.pdx, #7) runs first and can
// short-circuit the whole pipeline before any write happens.
//
// ----------------------------------------------------------------------
// Layout this file chooses (a fixed, small M2 default -- see design/
// architecture.md §9 for the full byte-offset <-> LBA/bcount derivation
// and the gaps this leaves for later milestones)
// ----------------------------------------------------------------------
//
//   Block 0            : PDXB superblock (4096 B, written by
//                         pdxb_encode_superblock)
//   Blocks [1, 9)       : inode table -- 256 inodes * 128 B = 32768 B =
//                         8 blocks (itable_lba=1, itable_bcount=8)
//   Block  9            : allocator bitmap -- only 1024 B of this block
//                         are meaningful; the rest is zero padding
//                         (alloc_lba=9, alloc_bcount=1 -- see design/
//                         architecture.md §9 for why this is a fixed
//                         1024-byte default rather than a real
//                         data_bcount/8 computation)
//   Blocks [10, 10+N)   : journal ring, N = the caller's journal_size
//                         (already in BLOCKS -- src/argv.pdx's
//                         ParsedArgv.journal_size is documented as
//                         "u64 block count", default 1024 -- see
//                         design/architecture.md §9 for the task-brief
//                         byte-count wording this reconciles)
//                         (journal_lba=10, journal_bcount=N)
//
// total_blocks is set to journal_lba + journal_bcount (10 + N) -- i.e.
// this M2 landing allocates NO data region (data_lba/data_bcount are
// left at 0). There is no `--size=` flag yet (src/argv.pdx's M1
// surface does not have one) to size a real data region against; see
// design/architecture.md §9 for why this is flagged as a gap rather
// than silently guessed.
//
// ----------------------------------------------------------------------
// Root inode #1 (mkfs.pdxfs.M2-003, #6)
// ----------------------------------------------------------------------
//
// design/filesystem/volume-fs-substrate.md §2.3 (paideia-os) is the
// authoritative 128-byte on-disk inode layout (header/inode_no/
// byte_len/created_ns/mtime_ns/refcount/root_block/cow_gen/
// content_hash/sig_prefix/sig_hash) -- NOT the looser "mode/size/
// link_count/timestamp/block_ptrs" vocabulary #6's own task brief uses.
// This file encodes the REAL wire layout (so a future mount.pdxfs reads
// back a valid inode) and maps the brief's intent onto it: mode=DIR ->
// header's file_type nibble = PDX_INODE_FT_DIR (a LOCAL placeholder
// constant -- no canonical file_type registry exists yet anywhere in
// the tree, see design/architecture.md §9); size=0 -> byte_len=0;
// link_count=2 -> refcount=2 (the "on-disk hardlink count" field per
// §2.3's own row); timestamp=0 -> created_ns=mtime_ns=0; block_ptrs=
// all-zero -> root_block=0 (an empty directory has no CoW-tree yet).
// cow_gen/content_hash/sig_prefix/sig_hash are all zero (unsigned,
// untouched -- signing is mkfs.pdxfs.M3-002).
//
// There is no `libpdx-volume.inode_encoders` module yet (flagged by
// #6's own task brief and confirmed absent here too -- this file
// therefore encodes the 128 bytes inline, matching the encoder-gap
// discipline and register-preservation conventions this whole repo
// already uses for its own inline PDXB-adjacent encoding). See
// design/architecture.md §9 for the follow-up this leaves for
// libpdx-volume.
//
// ----------------------------------------------------------------------
// Cross-repo call: pdxb_encode_superblock
// ----------------------------------------------------------------------
//
// `call pdxb_encode_superblock;` below reaches libpdx-volume's
// src/pdxb_superblock.pdx WITHOUT any `extern`/import declaration --
// paideia-as has no such keyword (confirmed: no grep hit anywhere in
// tools/paideia-as's own source or design docs). This repo's OWN
// build.sh already relies on the identical mechanism for every
// cross-FILE call within mkfs.pdxfs itself (main.pdx calls
// argv_parse/target_classify/format_record_emit_dry_run, each defined
// in a different src/*.pdx, yet build.sh compiles every src/*.pdx into
// an INDEPENDENT .o with no multi-file compilation unit) -- a bare
// `call <label>` where <label> is not defined in the current
// compilation unit becomes an ordinary undefined-global-symbol ELF
// relocation, resolved whenever something finally links this repo's
// .o files together with libpdx-volume's (the same "once built and
// linked into a runnable image" step README.md already flags as
// outside build.sh's own scope). A cross-REPO call is therefore
// syntactically and mechanically IDENTICAL to a cross-file call within
// one repo -- both are just "a label this compilation unit does not
// define." See design/architecture.md §9 for this write-up in full.
//
// ----------------------------------------------------------------------
// No lseek anywhere -- and why
// ----------------------------------------------------------------------
//
// design/user/syscall-table.md (paideia-os, refreshed through sysno 95)
// has NO lseek entry at any number -- this kernel does not have one.
// #6's task brief describes writing the zeroed inode table, then
// "seek back to inode #1's offset ... and write" the real root inode --
// impossible without lseek. This file instead writes the inode-table
// region as three SEQUENTIAL sys_write calls that together cover the
// whole region in the correct final byte layout, relying only on each
// fd's cursor auto-advancing after every write (the same mechanism the
// task brief's own steps 3-7 already use for the superblock -> inode
// table -> bitmap -> journal sequence): (1) 128 zero bytes for inode 0
// (the invalid-inode sentinel, design/filesystem/volume-fs-substrate.md
// §2.3), (2) the 128-byte real root inode for inode 1, (3)
// (256-2)*128 = 32512 zero bytes for inodes 2..255. This produces the
// byte-identical on-disk region a seek-back-and-patch approach would,
// using only forward-sequential writes. See design/architecture.md §9.
//
// ----------------------------------------------------------------------
// Exit-status contract
// ----------------------------------------------------------------------
//
// design/tooling/volume-tooling-ux.md's own exit-code table (§ near
// "Exit codes: 0=OK, 2=argv parse error, 3=system error ..., 5=data-
// integrity refusal"): `mkfs_format_run` returns 0 (OK), 3
// (MKFS_EXIT_SYSCALL_ERROR -- any open/write/encode failure), or 5
// (MKFS_EXIT_REFUSED -- the non-blank gate fired without --force).
// main.pdx passes this return value straight to sys_exit.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero/equality
// check is `cmp reg, 0` or `cmp reg, imm`. No `imul`/`mul` for a
// compile-time-constant multiply -- the one such multiply this file
// needs (journal_size_blocks * 4096) is done via `shl reg, 12` (4096 =
// 2^12), matching this codebase's established shl/add decomposition
// convention (src/argv.pdx's argv_parse_u64_dec, `count*24` in
// src/kernel/acpi/madt.pdx). A negative syscall return is turned into a
// positive errno via `xor reg,reg; sub reg,rax` (NOT a bare `neg`),
// matching src/user/errno.pdx's syscall_check precedent exactly.
// Reserved-label discipline: every branch label in this file is
// prefixed `mkfs_format_`.
//
// SC+ IDs used (design/user/syscall-table.md): 1 = sys_write,
// 2 = sys_open, 3 = sys_close.
//
// Register-preservation discipline (design/architecture.md §7): every
// function below that repurposes a SysV callee-save register pushes it
// on entry and pops it (reverse order) before its single `ret`.
//
// ----------------------------------------------------------------------
// mkfs.pdxfs.M3-002 (#9) — superblock signing
// ----------------------------------------------------------------------
//
// `libpdx-volume`'s M3 landing (commit 6f18957) ships a REAL
// `pdxb_sign_superblock(sb_ptr, seed_ptr, out_sig_ptr, out_sig_len) ->
// u64`:
//
//   rdi = sb_ptr        4096-byte encoded superblock; only [0,696) is
//                       READ (signed)
//   rsi = seed_ptr      32-byte ML-DSA-65 seed, a RAW POINTER -- not a
//                       cap slot number
//   rdx = out_sig_ptr   destination for the 3309-byte signature
//   rcx = out_sig_len   caller-declared writable length at out_sig_ptr
//                       (must be >= 3309 or the call returns
//                       PDXB_SIGN_ERR without touching output)
//   returns             3309 (the ML-DSA-65 signature length actually
//                       written) on success, or
//                       0xFFFFFFFFFFFFFFFF (PDXB_SIGN_ERR) on failure
//
// `libpdx-volume`'s own module header documents a deliberate rename from
// this wave's issue-brief wording (`sig_key_slot`, implying a cap slot
// holding `KIND_SIG_KEY`) to `seed_ptr`: "`KIND_SIG_KEY` as landed... is
// a PUBLIC-key handle... There is no `R_SIGK_WRITE`/read-seed op and no
// kernel capability kind anywhere in the tree that holds a PRIVATE
// ML-DSA-65 signing seed." `mkfs_format_run` below therefore never
// touches `KIND_SIG_KEY` (this repo's own caps.decl already flags it as
// a placeholder never dereferenced by any code path) and instead passes
// a raw 32-byte seed pointer.
//
// This call SIGNS IN PLACE: `mkfs_format_run` passes
// `&mkfs_format_sb_encoded` as `sb_ptr` (the full 4096-byte encoded
// buffer `pdxb_encode_superblock` just produced -- not the 176-byte
// `PdxbSuperblockSummary`; `libpdx-volume`'s own architecture.md §8.3 is
// explicit that passing just the summary is insufficient) and
// `&mkfs_format_sb_encoded + 696` as `out_sig_ptr`, so the 3309
// signature bytes land exactly at this issue's own instruction --
// "the result overwrites sb_ptr[696..696+3309]" -- before the buffer is
// ever written to the target.
//
// ----------------------------------------------------------------------
// Seed-key strategy: placeholder all-zero seed, real loading deferred
// ----------------------------------------------------------------------
//
// This repo's `--sig-key` argv flag (`src/argv.pdx`'s
// `PA_OFF_SIG_KEY_PTR`) stores a raw cap-URI STRING pointer -- it has
// never been dereferenced or resolved into actual key MATERIAL by any
// code path in this repo (M1's own caps.decl note: "Not referenced by
// any M1 function"). Loading a real 32-byte private ML-DSA-65 seed from
// that URI needs a key-management library (`libpdx-key` or equivalent)
// that does not exist anywhere in `paideia-satellites/` as of this
// landing -- the same "design-doc-mentioned, not yet bootstrapped"
// status this repo's own §3 note documents for `libpdx-argv` at M1.
//
// Per this issue's own instruction, `mkfs_format_run` therefore signs
// EVERY superblock with a PLACEHOLDER all-zero 32-byte seed
// (`mkfs_sign_seed_zero`, a `.bss` buffer relying on the loader's
// one-time zero-init, exactly like `mkfs_format_zero_buf`'s "never
// written, permanently zero" pattern) REGARDLESS of whether `--sig-key`
// was given -- the flag's value is accepted by argv but not yet
// consulted here. This produces a well-FORMED signature (the wire
// bytes at offset 696 are a real ML-DSA-65 signature over the correct
// 696-byte message, computed with a real intrinsic) that will NOT
// verify against any real public key a future `--sig-key`-loaded
// `KIND_SIG_KEY` might name -- it is cryptographically inert, not
// merely "unsigned". **Flagged for main**: this is a deliberate, loud,
// temporary M3 landing choice (this issue's own acceptance text: "use a
// placeholder seed... and document"), not a security regression to fix
// silently -- the fix is `libpdx-key` (or equivalent) landing a real
// seed-loading path this file can call instead of `mkfs_sign_seed_zero`.
//
// Every successful file-target write's terminal record now reads
// `result_code: SIGNED_OK` (`FormatRecord::FR_RESULT_SIGNED_OK`, M3)
// rather than M2's `OK` -- "signed" here means "the wire bytes are
// populated by a real signing call", not "verifiably signed by a real
// key" (see above).
//
// ----------------------------------------------------------------------
// mkfs.pdxfs.M3-001 (#8) — device-target pipeline: a documented stub
// ----------------------------------------------------------------------
//
// `mkfs_format_run_device` (new, M3) is what `src/main.pdx`'s
// device-target dispatch calls once `src/elevate_wire.pdx`'s
// (fail-closed, always-DENY at this landing) elevation check has been
// consulted -- see that file's own module header for why the GRANT arm
// below is real, wired code that is nonetheless unreachable today.
//
// Per this issue's own fallback instruction ("If those ops don't exist
// yet (grep to confirm), STUB..."): a repo-tree grep of
// `design/user/syscall-table.md` (refreshed through sysno 95) plus
// `src/kernel/core/cap/` finds exactly ONE block-device-cap-shaped
// syscall, `blkdev_cap_request(bus, devfn, flags) -> KIND_BLKDEV slot |
// -errno` (sysno 74) -- a cap-MINTING call, not a block-granularity
// open/write/flush op. No `sys_blkdev_write`/`sys_blkdev_read`-shaped
// syscall exists anywhere in the table. There is therefore no real
// write path this function could call even if `src/target.pdx`'s
// `mkfs_dev_parse_slot` + `src/elevate_wire.pdx`'s elevation check both
// succeeded. `mkfs_format_run_device` parses the slot (a real, working
// call into `Target::mkfs_dev_parse_slot`) and then immediately emits
// `PdxFsFormatRecord@0.1 { result_code: DEVICE_TARGET_STUB }` via
// `src/pipe_wire.pdx`'s wrapper, performing NO write of any kind --
// exactly this issue's own documented-stub acceptance shape.
//
// Upstream: design/tooling/volume-tooling-ux.md §3 (paideia-os);
// design/filesystem/volume-fs-substrate.md §2.1, §2.3 (paideia-os);
// src/pdxb_superblock.pdx, src/pdxb_sign.pdx (libpdx-volume, the
// encoders/signer this file calls); src/elevate_wire.pdx,
// src/pipe_wire.pdx, src/target.pdx (this repo, M3 siblings).
//
// ----------------------------------------------------------------------
// mkfs.pdxfs.LV11 (v1.1.0) -- libpdx-volume v1.1 adoption pass
// ----------------------------------------------------------------------
//
// Issue #24 (LV11-024): every per-field summary store in
// `mkfs_format_build_superblock` now routes through libpdx-volume's
// LV.M1-003 (#18) `pdxb_sb_set_*` accessor family, and every hardcoded
// summary offset / on-disk offset immediate in this file's comment
// text now cites the matching PdxbSuperblock:: exported constant
// (SB_SUMMARY_BYTES, PDXB_ONDISK_BYTES, PDXB_D_OFF_SIG). See that
// function's own header for the leaf->caller-preserving register-plan
// change the setter-call rewrite required.
//
// Issue #25 (LV11-025): `mkfs_format_run` accepts two additional
// arguments (`flags`, `passphrase_fd`) carrying the v1.1 argv
// extension bits (`PA_FLAG_ENCRYPT` / `PA_FLAG_QUOTA_SET` /
// `PA_FLAG_PASSPHRASE_FD_SET`) and, when either bit is set, extends
// the pipeline between build_superblock and encode with a summary-
// level flag/version stamp (`Encrypt::mkfs_encrypt_apply_flag` /
// `Quota::mkfs_quota_apply_flag` -- both set `PDXB_VERSION_V2` via
// `pdxb_sb_set_version` and OR their respective `PDXB_FLAG_*` bit
// into `SBS_OFF_FLAGS` via `pdxb_sb_set_flags`) and between encode
// and sign with an on-disk-buffer-level wrapped-DEK/salt/nonce stamp
// (`Encrypt::mkfs_encrypt_apply_wrap` -- reads the passphrase from
// the caller's fd via a real sys_read, derives a KEK through
// `pdxb_kek_derive`, wraps a placeholder all-zero DEK through
// `pdxb_dek_wrap`, and writes the resulting fields via
// `pdxb_sb_set_wrapped_dek` / `pdxb_sb_set_kdf_salt` plus a direct
// 12-byte store at `PDXB_D_OFF_WRAP_NONCE`). See `src/encrypt.pdx`
// and `src/quota.pdx` for the two extension bodies. The signed
// message-length is unchanged: `pdxb_sign_superblock` still signs
// exactly `PDXB_D_OFF_SIG` (696) bytes, which cover the wrapped-DEK/
// salt/nonce v2 fields at offsets 192/240/256 as well.

module Format = structure {

  // --- Fixed M2 layout constants (see module header). All LBA/bcount
  //     values are in 4096-byte BLOCKS, matching volume-fs-substrate.md
  //     §2.1's on-disk field semantics -- NOT raw byte offsets. -------
  pub let MKFS_BLOCK_SIZE     : u64 = 4096
  pub let MKFS_INODE_COUNT    : u64 = 256
  pub let MKFS_INODE_SIZE     : u64 = 128
  pub let MKFS_ITABLE_LBA     : u64 = 1
  pub let MKFS_ITABLE_BCOUNT  : u64 = 8      // 256*128 / 4096
  pub let MKFS_BITMAP_BYTES   : u64 = 1024
  pub let MKFS_ALLOC_LBA      : u64 = 9      // ITABLE_LBA + ITABLE_BCOUNT
  pub let MKFS_ALLOC_BCOUNT   : u64 = 1
  pub let MKFS_JOURNAL_LBA    : u64 = 10     // ALLOC_LBA + ALLOC_BCOUNT
  pub let MKFS_ROOT_INODE_NO  : u64 = 1

  // --- sys_open flags/mode (verified against src/user/cp.pdx's dst-open
  //     precedent in the paideia-os monorepo: O_CREAT|O_WRONLY|O_TRUNC =
  //     0x40|0x01|0x80 = 0xC1, mode 0x1A4 = 0644). ----------------------
  pub let MKFS_OPEN_FLAGS : u64 = 0xC1
  pub let MKFS_OPEN_MODE  : u64 = 0x1A4

  // --- mkfs_format_run exit-status contract (see module header). -----
  pub let MKFS_EXIT_OK                 : u64 = 0
  pub let MKFS_EXIT_SYSCALL_ERROR      : u64 = 3
  pub let MKFS_EXIT_DEVICE_STUB        : u64 = 4  // M3 (#8): device write path is a documented stub
  pub let MKFS_EXIT_REFUSED            : u64 = 5
  pub let MKFS_EXIT_ELEVATION_DENIED   : u64 = 6  // M3 (#12): device-target elevation always denies

  // --- mkfs.pdxfs.M3-002 (#9): signing constants (see module header). ----
  //
  // As of mkfs.pdxfs.LV11-024 (#24) both immediates cite the matching
  // libpdx-volume/src/pdxb_superblock.pdx exported constant:
  //   MKFS_SIGN_SIG_OFFSET == PDXB_D_OFF_SIG (696) -- start of the
  //     on-disk superblock's signature slot; also pdxb_sign_superblock's
  //     signed message-length. See pdxb_superblock.pdx's PDXB_D_OFF_SIG
  //     binding.
  //   MKFS_SIGN_SIG_LEN    == MLDSA65_SIG_LEN (3309) -- the actual
  //     ML-DSA-65 signature byte-count returned by pdxb_sign_superblock
  //     (distinct from PDXB_D_SIG_BYTES = 3400, the reserved on-disk
  //     signature-slot size, which INCLUDES a 91-byte trailing pad
  //     kept for future signature-scheme migration; see
  //     libpdx-volume/src/pdxb_sign.pdx).
  pub let MKFS_SIGN_SIG_OFFSET : u64 = 696   // PDXB_D_OFF_SIG
  pub let MKFS_SIGN_SIG_LEN    : u64 = 3309  // MLDSA65_SIG_LEN

  // --- mkfs.pdxfs.LV11-024 (#24): cite libpdx-volume v1.1 exported
  //     constants for immediates below. paideia-as does not resolve
  //     cross-file `pub let` bindings as inline immediates in another
  //     file's compilation unit (see this codebase's established
  //     comment-citing convention -- e.g. src/format_record.pdx's own
  //     note on this and src/main.pdx's `and rax, 0x2; // PA_FLAG_DRY_RUN`
  //     precedent), so each of the constants below appears in this file
  //     as a numeric literal in a mov/cmp with a CITING COMMENT rather
  //     than an inline symbol.
  //
  //   PDXB_ONDISK_BYTES (4096) -- pdxb_encode_superblock's out_len and
  //     the on-disk superblock byte count.
  //   SB_SUMMARY_BYTES  (176)  -- PdxbSuperblockSummary in-memory size;
  //     matches mkfs_format_sb_summary's .bss reserve.
  //   SB_SUMMARY_SLOTS  (22)   -- number of u64 slots the zero-fill loop
  //     in mkfs_format_build_superblock covers.
  //   PDXB_D_OFF_SIG    (696)  -- start of the on-disk superblock's
  //     signature slot (MKFS_SIGN_SIG_OFFSET's citation).
  //
  //     LV.M5-002 (#30) v2 on-disk offsets used at mkfs.pdxfs.LV11-025:
  //   PDXB_D_OFF_WRAPPED_DEK (192) -- 48 B ct+tag
  //   PDXB_D_OFF_KDF_SALT    (240) -- 16 B
  //   PDXB_D_OFF_WRAP_NONCE  (256) -- 12 B (no accessor in v1.1.1 -- see
  //     src/encrypt.pdx's module header for the flagged libpdx-volume gap)

  // --- .bss scratch. All zero-initialised by the loader; every buffer
  //     below is fully re-stamped by its owning function before use
  //     except mkfs_format_zero_buf and mkfs_sign_seed_zero, which are
  //     NEVER written by any function in this file and stay permanently
  //     zero for the whole process lifetime -- mkfs_format_zero_buf
  //     exists solely to be the source buffer of every zero-fill
  //     sys_write; mkfs_sign_seed_zero exists solely to be the
  //     placeholder 32-byte ML-DSA-65 seed every M3 signing call uses
  //     (see module header's "Seed-key strategy" section for why this
  //     is a deliberate, documented, temporary choice). -----------------
  //
  // Every array-size literal below cites its libpdx-volume public
  // constant per mkfs.pdxfs.LV11-024 (#24) -- paideia-as array sizes
  // MUST be integer literals, so the citation is comment-only (same
  // constraint libpdx-volume's own src/pdxb_crypto.pdx documents for
  // its own `[u8; 80]` / `[u8; 32]` scratch reserves).
  //
  pub let mut mkfs_format_sb_summary : [u8; 176]  = uninit @align(8)  // SB_SUMMARY_BYTES  (PdxbSuperblockSummary, SBS_OFF_* layout)
  pub let mut mkfs_format_sb_encoded : [u8; 4096] = uninit @align(8)  // PDXB_ONDISK_BYTES (on-disk superblock image)
  pub let mut mkfs_format_root_inode : [u8; 128]  = uninit @align(8)  // MKFS_INODE_SIZE   (encoded root inode #1)
  pub let mut mkfs_format_zero_buf   : [u8; 4096] = uninit @align(8)  // PDXB_ONDISK_BYTES (permanently-zero scratch)
  pub let mut mkfs_sign_seed_zero    : [u8; 32]   = uninit @align(8)  // MLDSA65_SEED_LEN  (placeholder ML-DSA-65 seed, M3, #9)

  // ==========================================================================
  // mkfs_format_write_zeros(fd, total_bytes) -> u64
  //   (0 on success, or the negative errno from the first failing
  //   sys_write -- same sentinel convention as a raw syscall return)
  //
  // Writes `total_bytes` zero bytes to `fd` at its current cursor
  // position, via repeated sys_write calls of at most 4096 bytes each
  // (mkfs_format_zero_buf's fixed size). This is the mechanism this
  // whole file uses instead of lseek + a single big write, or instead
  // of a giant .bss buffer sized to the largest zero-fill span needed
  // (the journal region can be arbitrarily large per --journal-size) --
  // see module header for why lseek is unavailable.
  //
  // A non-negative sys_write return is trusted to mean "the whole
  // requested chunk was written" with no short-write retry loop, same
  // posture src/user/cat.pdx documents for its own sys_write calls
  // ("a short write would technically require a retry loop... adding
  // one here would be defensive dead code at this round").
  //
  // Register plan: rbx = fd, r12 = remaining byte count, both SysV
  // callee-save, pushed on entry and popped before either `ret`.
  // ==========================================================================
  pub let mkfs_format_write_zeros : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (fd: u64) (total_bytes: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "mkfs.pdxfs.M2-002 (#5): mkfs_format_write_zeros entry point. push rbx; push r12. rbx=fd, r12=remaining bytes. Loop (mkfs_format_wz_loop): `cmp r12, 0; je mkfs_format_wz_done` (all bytes written -- success, rax=0). Otherwise compute this iteration's chunk size in rdx via a branch-based min(remaining, 4096): `mov rdx, r12; cmp rdx, 4096; jbe mkfs_format_wz_have_chunk` (remaining already <= 4096, rdx is correct as-is) else `mov rdx, 4096`. sys_write(rdi=rbx, rsi=&mkfs_format_zero_buf, rdx=chunk, rax=1); `cmp rax, 0; jl mkfs_format_wz_err` returns the negative errno unchanged (rax untouched since the syscall) with rbx/r12 popped first. On success: `sub r12, rdx` (register-only, no add-reg-mem) and loop. Pops rbx/r12 (reverse push order) before every return. No `add reg,[mem]`. No `test`. Labels prefixed mkfs_format_wz_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                       // rbx = fd
        mov r12, rsi;                       // r12 = remaining bytes

      mkfs_format_wz_loop:
        cmp r12, 0;
        je mkfs_format_wz_done;

        mov rdx, r12;
        cmp rdx, 4096;
        jbe mkfs_format_wz_have_chunk;
        mov rdx, 4096;

      mkfs_format_wz_have_chunk:
        mov rdi, rbx;
        lea rsi, [rip + mkfs_format_zero_buf];
        mov rax, 1;
        syscall;
        cmp rax, 0;
        jl mkfs_format_wz_err;

        sub r12, rdx;
        jmp mkfs_format_wz_loop;

      mkfs_format_wz_err:
        pop r12;
        pop rbx;
        ret;

      mkfs_format_wz_done:
        xor rax, rax;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // mkfs_format_build_superblock(journal_size_blocks) -> ()
  //
  // Populates mkfs_format_sb_summary (176-byte PdxbSuperblockSummary,
  // libpdx-volume's SBS_OFF_* layout, PdxbSuperblock::SB_SUMMARY_BYTES)
  // with this file's fixed M2 layout (see module header).
  //
  // ----------------------------------------------------------------------
  // mkfs.pdxfs.LV11-024 (#24) -- API cleanup: accessor adoption
  // ----------------------------------------------------------------------
  //
  // libpdx-volume v1.1 (LV.M1-003 / #18) landed a full family of
  // per-field getters/setters over the 22-slot PdxbSuperblockSummary
  // layout. Per issue #24's acceptance ("No hardcoded superblock-summary
  // offset math remaining in this tool's src tree (grep clean)"): every
  // per-field store in this function has been rewritten to call the
  // corresponding `pdxb_sb_set_*` entry point from
  // libpdx-volume/src/pdxb_superblock.pdx, so a future rearrangement of
  // the summary layout (adding a new field, widening one, reordering)
  // does NOT require this function to be re-derived from an offset
  // table.
  //
  // The bulk zero-fill loop is KEPT rather than replaced with 22
  // setter calls: it is a scale-8 SIB store loop bounded by the
  // exported constant SB_SUMMARY_SLOTS (22), not per-field offset math,
  // and matches libpdx-volume's own pdxb_encode_superblock zero-fill
  // idiom byte-for-byte. Reworking it as 22 zero-setter calls would be
  // slower and no more "offset-free" than the current single-loop form.
  //
  // Register plan changes from the M2 landing: this function was a pure
  // leaf; the setter-call rewrite promotes it to a caller-preserving
  // shape. `push rbx; push r12; push r13` on entry save the two
  // callee-save registers this function actually needs (rbx =
  // &summary held across every setter call; r12 = journal_size_blocks
  // preserved across the total_blocks setter which computes rsi =
  // journal + 10 in-register) plus a THIRD throwaway `push r13` added
  // in mkfs.pdxfs 1.1.1 fixup (Bug #3) purely for rsp%16==0 stack
  // alignment across the eleven nested `call` sites -- SysV entry
  // hands us rsp%16==8, so an odd number of pushes (three) restores
  // rsp%16==0 as the callees expect. r13 itself is never read; only
  // the epilogue `pop r13` matches the entry push. Every pdxb_sb_set_*
  // callee touches only caller-save registers (rax/rdi/rsi per each
  // setter's own justification, all pure leaves), so rbx and r12
  // survive every nested `call` transparently. Pops occur in reverse
  // order (r13, r12, rbx) before the single `ret`. Callers do not need to
  // change: mkfs_format_run already treated this function as a callee
  // that clobbers no callee-save register, which is still true after
  // this rework.
  // ==========================================================================
  pub let mkfs_format_build_superblock : (u64) -> () !{mem} @{} =
    fn (journal_size_blocks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mkfs.pdxfs.M2-002 (#5) + LV11-024 (#24) + 1.1.1 fixup (Bug #3): mkfs_format_build_superblock entry point. push rbx; push r12; push r13 before repurposing either -- r13 is a throwaway third push whose ONLY role is to keep rsp % 16 == 0 across the eleven nested pdxb_sb_set_* calls (SysV entry hands us rsp % 16 == 8, two callee-save pushes would leave rsp % 16 == 8 which is a stack-misalignment ABI violation at every call site even though the leaf callees themselves currently tolerate it; three pushes restore rsp % 16 == 0, matching mkfs_encrypt_apply_wrap's rbx/r12/r13 push shape). r13 itself is never read, only stored back to on the epilogue pop. rbx = &mkfs_format_sb_summary (rip-relative lea, held across every nested setter call). r12 = journal_size_blocks (the incoming rdi, preserved across the pdxb_sb_set_total_blocks call whose rsi is computed as r12 + 10 in-register). Zero-fill pass first: `xor rcx,rcx; xor rdx,rdx` then a 22-iteration `mov [rbx+rcx*8], rdx; add rcx,1; cmp rcx,22; jb loop` bounded by SB_SUMMARY_SLOTS (22, PdxbSuperblock::SB_SUMMARY_SLOTS -- same scale-8 SIB store idiom libpdx-volume's pdxb_encode_superblock uses for its own zero-fill). Then eleven setter calls via libpdx-volume/src/pdxb_superblock.pdx's per-field API (LV.M1-003, #18): pdxb_sb_set_magic(rbx, 0x42584450='PDXB'), pdxb_sb_set_version(rbx, 1=PDXB_VERSION_V1), pdxb_sb_set_block_size(rbx, 4096=PDXB_BLOCK_SIZE), pdxb_sb_set_total_blocks(rbx, r12+10 computed via `mov rsi,r12; add rsi,10` -- register-only add, no add-reg-mem), pdxb_sb_set_itable_lba(rbx, 1), pdxb_sb_set_itable_bcount(rbx, 8), pdxb_sb_set_alloc_lba(rbx, 9), pdxb_sb_set_alloc_bcount(rbx, 1), pdxb_sb_set_journal_lba(rbx, 10), pdxb_sb_set_journal_bcount(rbx, r12 verbatim -- ParsedArgv.journal_size is already in BLOCKS per src/argv.pdx's own documented contract), pdxb_sb_set_root_inode(rbx, 1=MKFS_ROOT_INODE_NO). Every pdxb_sb_set_* callee is a pure leaf per its own libpdx-volume/src/pdxb_superblock.pdx justification (touches only rax/rdi/rsi, caller-save under SysV, no push/pop, no nested call) -- so rbx and r12 survive every setter call transparently without further register-save work. Every other summary slot (flags, uuid_lo/hi, data_lba, data_bcount, mount_gen, snap_head, four sig_key_hash words) is left at the zero-fill pass's value -- see module header for why (no --size= flag to size a data region, unsigned-key placeholder at M3). Pop r13; pop r12; pop rbx (reverse push order, per 1.1.1 fixup Bug #3) before the single ret. No `add reg,[mem]` (`add rsi,10` is register-only). No `test`. Labels prefixed mkfs_format_bsb_.",
      block: {
        push rbx;
        push r12;
        push r13;                           // 1.1.1 Bug #3: throwaway third push for rsp%16==0

        lea rbx, [rip + mkfs_format_sb_summary];
        mov r12, rdi;                       // r12 = journal_size_blocks

        xor rcx, rcx;
        xor rdx, rdx;

      mkfs_format_bsb_zero_loop:
        mov [rbx + rcx*8], rdx;
        add rcx, 1;
        cmp rcx, 22;                        // SB_SUMMARY_SLOTS (libpdx-volume)
        jb mkfs_format_bsb_zero_loop;

        // ---- LV.M1-003 (#18) accessor calls, per issue #24 acceptance. ----
        mov rdi, rbx;
        mov rsi, 0x42584450;                // PDXB_MAGIC ("PDXB")
        call pdxb_sb_set_magic;

        mov rdi, rbx;
        mov rsi, 1;                         // PDXB_VERSION_V1
        call pdxb_sb_set_version;

        mov rdi, rbx;
        mov rsi, 4096;                      // PDXB_BLOCK_SIZE
        call pdxb_sb_set_block_size;

        mov rdi, rbx;
        mov rsi, r12;                       // total_blocks = journal_size + 10
        add rsi, 10;
        call pdxb_sb_set_total_blocks;

        mov rdi, rbx;
        mov rsi, 1;                         // MKFS_ITABLE_LBA
        call pdxb_sb_set_itable_lba;

        mov rdi, rbx;
        mov rsi, 8;                         // MKFS_ITABLE_BCOUNT (256*128/4096)
        call pdxb_sb_set_itable_bcount;

        mov rdi, rbx;
        mov rsi, 9;                         // MKFS_ALLOC_LBA
        call pdxb_sb_set_alloc_lba;

        mov rdi, rbx;
        mov rsi, 1;                         // MKFS_ALLOC_BCOUNT
        call pdxb_sb_set_alloc_bcount;

        mov rdi, rbx;
        mov rsi, 10;                        // MKFS_JOURNAL_LBA
        call pdxb_sb_set_journal_lba;

        mov rdi, rbx;
        mov rsi, r12;                       // journal_bcount = journal_size verbatim
        call pdxb_sb_set_journal_bcount;

        mov rdi, rbx;
        mov rsi, 1;                         // MKFS_ROOT_INODE_NO
        call pdxb_sb_set_root_inode;

        pop r13;                            // 1.1.1 Bug #3: matches the entry push_r13
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // mkfs_format_encode_root_inode() -> ()
  //
  // Populates mkfs_format_root_inode (128 bytes, design/filesystem/
  // volume-fs-substrate.md §2.3's on-disk layout) as an empty root
  // directory -- see module header for the mapping from #6's task-brief
  // vocabulary onto this real layout. No args, no return.
  //
  // Leaf function: touches only caller-save registers -- no push/pop.
  // ==========================================================================
  pub let mkfs_format_encode_root_inode : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mkfs.pdxfs.M2-003 (#6): mkfs_format_encode_root_inode entry point. rax = &mkfs_format_root_inode. Zero-fill pass: 16-iteration `mov [rax+rcx*8], rdx; add rcx,1; cmp rcx,16; jb loop` (128/8=16 slots), same idiom as mkfs_format_build_superblock's zero-fill. Then three explicit field stores: header (+0) = 0x01010000000001ED -- built from `in_use[63:56]=1` (bit 56 set, 0x0100000000000000), `file_type[55:48]=PDX_INODE_FT_DIR=1` (bit 48 set, 0x0001000000000000), `mode_bits[15:0]=0755` (0x1ED octal-755), summed at compile time into one verbatim 64-bit immediate (a bare `mov reg, imm64` loads this exact bit pattern unsigned via MOVABS, which is the CORRECT behaviour here since every bit is meant literally -- unlike src/user/errno.pdx's #613 hazard, which was about wanting a SIGN-EXTENDED negative boundary and getting a verbatim load instead; this constant wants exactly a verbatim load, matching libpdx-volume's own PDXB_ENC_ERR_BUF_TOO_SHORT=0xFFFFFFFFFFFFFFFF precedent for the same pattern). inode_no (+8) = 1 (MKFS_ROOT_INODE_NO). refcount (+40) = 2 (empty directory's link count: itself + its would-be '.' entry, matching the task brief's link_count=2). Every other slot (byte_len, created_ns, mtime_ns, root_block, cow_gen, content_hash, sig_prefix x3, sig_hash x4) is left at the zero-fill pass's value, matching the task brief's size=0/timestamp=0/block_ptrs=all-zero intent verbatim. No `add reg,[mem]`. No `test`. Labels prefixed mkfs_format_eri_.",
      block: {
        lea rax, [rip + mkfs_format_root_inode];

        xor rcx, rcx;
        xor rdx, rdx;

      mkfs_format_eri_zero_loop:
        mov [rax + rcx*8], rdx;
        add rcx, 1;
        cmp rcx, 16;
        jb mkfs_format_eri_zero_loop;

        mov rdx, 0x01010000000001ED;        // header: in_use=1, file_type=DIR(1), mode=0755
        mov [rax + 0], rdx;

        mov rdx, 1;                         // inode_no = 1 (root)
        mov [rax + 8], rdx;

        mov rdx, 2;                         // refcount (link_count) = 2
        mov [rax + 40], rdx;

        ret;
      }
    }

  // --- LV11-025 (#25) argv-extension scratch. -----------------------------
  //
  // `mkfs_format_run` gained two extra parameters (flags in rcx,
  // passphrase_fd in r8) at LV11-025 (see this file's module header's
  // LV11 section). All five SysV callee-save registers (rbx/r12-r15)
  // are already spoken for by the existing register plan, so the two
  // new arguments stage into these two .bss slots on entry and every
  // downstream read is a fresh `mov rax, [rip + ...]` load rather than
  // occupying a sixth register that does not exist. Both slots are
  // scoped to a single mkfs_format_run invocation; a caller that
  // interleaves two mkfs_format_run calls would race them, but no such
  // caller exists (main.pdx invokes this function at most once per
  // process, then sys_exits).
  pub let mut mkfs_format_v11_flags : u64 = uninit @align(8)
  pub let mut mkfs_format_v11_pfd   : u64 = uninit @align(8)

  // --- Argv flag bit masks (mirror src/argv.pdx's PA_FLAG_* per this
  //     codebase's comment-citing convention). Kept as local literals so
  //     the `and` and `cmp` immediates in mkfs_format_run stay imm32-
  //     safe with no r10/r11 staging. ------------------------------------
  pub let MKFS_FMT_FLAG_ENCRYPT   : u64 = 0x80    // PA_FLAG_ENCRYPT
  pub let MKFS_FMT_FLAG_QUOTA_SET : u64 = 0x200   // PA_FLAG_QUOTA_SET

  // ==========================================================================
  // mkfs_format_run(target_ptr, force_flag, journal_size_blocks,
  //                 flags, passphrase_fd) -> u64
  //   (MKFS_EXIT_OK | MKFS_EXIT_SYSCALL_ERROR | MKFS_EXIT_REFUSED)
  //
  //   rdi = target_ptr          (NUL-terminated <target> path, already
  //                               classified TARGET_FILE by the caller)
  //   rsi = force_flag          (0 or 1 -- ParsedArgv.flags & PA_FLAG_FORCE)
  //   rdx = journal_size_blocks (ParsedArgv.journal_size, already in
  //                               BLOCKS with its M1 default applied)
  //   rcx = flags               (ParsedArgv.flags verbatim -- read for
  //                               PA_FLAG_ENCRYPT / PA_FLAG_QUOTA_SET
  //                               only at LV11-025; every other bit is
  //                               ignored on this path)
  //   r8  = passphrase_fd       (ParsedArgv.passphrase_fd; consulted iff
  //                               PA_FLAG_ENCRYPT is set. Caller MUST
  //                               have refused --encrypt without
  //                               --passphrase-fd upstream -- see
  //                               src/main.pdx's mkfs_main_encrypt_pfd_ok
  //                               gate, added in mkfs.pdxfs 1.1.1 fixup
  //                               (LV11-025 Bug #2): refuses on
  //                               PA_FLAG_ENCRYPT set + PA_FLAG_
  //                               PASSPHRASE_FD_SET unset with a
  //                               "mkfs.pdxfs: --encrypt requires
  //                               --passphrase-fd" stderr diagnostic
  //                               and sys_exit(2), so this arm never
  //                               reaches mkfs_encrypt_apply_wrap with
  //                               a zero-default passphrase_fd)
  //
  // The full M2 pipeline: refusal gate -> open(create+trunc) -> encode +
  // write superblock -> write inode table (sentinel + root inode +
  // remaining zeroed slots) -> write allocator bitmap zeros -> write
  // journal zeros -> close -> emit the terminal PdxFsFormatRecord@0.1
  // (OK, a REFUSED_* variant, or FAIL) itself, then return the exit
  // status for main.pdx to pass to sys_exit unchanged.
  //
  // LV11-025 extension: two hook points around encode/sign, per this
  // file's module header. Both are no-ops when neither
  // PA_FLAG_ENCRYPT nor PA_FLAG_QUOTA_SET is set, so an M2/M3-shape
  // invocation flows through the pipeline unchanged.
  //
  // Register plan: rbx=target_ptr, r12=force_flag (dead after the
  // refusal-gate call), r13=journal_size_blocks, r14=fd (valid only
  // from mkfs_format_run_open onward), r15=errno scratch on a failure
  // path. All five are SysV callee-save, pushed on entry and popped
  // (reverse order) before the single shared epilogue's `ret`. The
  // two LV11-025 arguments (rcx=flags, r8=passphrase_fd) stage into
  // .bss slots on entry so they survive every nested call without
  // consuming a sixth register.
  // ==========================================================================
  pub let mkfs_format_run : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs, paideia.crypto} =
    fn (target_ptr: u64) (force_flag: u64) (journal_size_blocks: u64) (flags: u64) (passphrase_fd: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, paideia.crypto},
      justification: "mkfs.pdxfs.M2-002/M2-003/M2-004 (#5, #6, #7) + M3-002/M3-003 (#9, #10): mkfs_format_run entry point, the file-target write pipeline. Pushes rbx/r12/r13/r14/r15 (5 registers) before repurposing any; pops all five (reverse order) at the single shared epilogue (mkfs_format_run_epilogue) before every return. rbx=target_ptr, r12=force_flag, r13=journal_size_blocks. Phase 1 (refusal gate): rdi=rbx, rsi=r12, `call mkfs_refuse_check` (src/refusal.pdx) -> rax in {REFUSE_OK=0, REFUSE_ALREADY_PDXB=2, REFUSE_ALREADY_PDXL=3, REFUSE_NON_BLANK=4}. `cmp rax,0; je mkfs_format_run_open` on OK. Otherwise: rdi=rbx, rsi=rax (the refusal code IS the matching FormatRecord::FR_RESULT_* code, by the one-for-one numbering src/refusal.pdx's own header documents), rdx=0 (errno unused for a refusal), `call mkfs_sp_emit_result` (M3, #10 -- src/pipe_wire.pdx's wrapper, NOT FormatRecord::format_record_emit_result directly; every terminal-record call site in this function was switched to this wrapper at M3, see module header); `mov rax,5` (MKFS_EXIT_REFUSED); jmp epilogue. Phase 2 (open): sys_open(rdi=rbx, rsi=0xC1 (O_CREAT|O_WRONLY|O_TRUNC), rdx=0x1A4 (0644), rax=2); `cmp rax,0; jl mkfs_format_run_open_fail` (no fd to close on this path). On success r14=fd. Phase 3 (superblock encode): rdi=r13, `call mkfs_format_build_superblock`; rdi=&mkfs_format_sb_summary, rsi=&mkfs_format_sb_encoded, rdx=4096, `call pdxb_encode_superblock` (libpdx-volume, cross-repo call by bare label -- see module header); `cmp rax,4096; jne mkfs_format_run_encode_fail` (defensive -- cannot actually fail since out_len is always exactly 4096, but pdxb_encode_superblock's own contract returns a distinct sentinel on a too-small buffer, so this gate is honoured rather than assumed). Phase 3b (M3, #9 -- sign in place): rdi=&mkfs_format_sb_encoded (sb_ptr), rsi=&mkfs_sign_seed_zero (seed_ptr, the placeholder all-zero seed -- see module header's Seed-key strategy section), rdx=&mkfs_format_sb_encoded+696 (out_sig_ptr, MKFS_SIGN_SIG_OFFSET), rcx=3309 (out_sig_len, MKFS_SIGN_SIG_LEN), `call pdxb_sign_superblock` (libpdx-volume, cross-repo bare-label call, same mechanism as pdxb_encode_superblock); `cmp rax,3309; jne mkfs_format_run_sign_fail` -- a failure here (PDXB_SIGN_ERR = 0xFFFFFFFFFFFFFFFF) is handled identically to an encode failure: no syscall errno exists, so mkfs_format_run_sign_fail sets the same sentinel r15 value and falls into the shared close_and_fail path. On success, the 3309 signature bytes are now resident in mkfs_format_sb_encoded[696..696+3309) -- the buffer sys_write below writes is now the SIGNED superblock. sys_write(r14, &mkfs_format_sb_encoded, 4096); `cmp rax,0; jl mkfs_format_run_close_fail`. Phase 4 (inode table, no lseek -- see module header): sys_write(r14, &mkfs_format_zero_buf, 128) for inode 0's sentinel slot via a DIRECT sys_write (128 <= 4096, one call suffices, no need for the write_zeros helper's chunking loop) -- fail check as above; `call mkfs_format_encode_root_inode`; sys_write(r14, &mkfs_format_root_inode, 128) for inode 1 -- fail check; rdi=r14, rsi=32512 ((256-2)*128), `call mkfs_format_write_zeros` for inodes 2..255 -- `cmp rax,0; jl mkfs_format_run_close_fail` (write_zeros itself returns the raw negative errno on failure, matching a direct syscall's convention). Phase 5 (bitmap): rdi=r14, rsi=1024 (MKFS_BITMAP_BYTES), `call mkfs_format_write_zeros` -- same fail check. Phase 6 (journal): `mov r8,r13; shl r8,12` (journal_size_blocks * 4096 via shift, avoiding imul per this codebase's compile-time-constant-multiply convention); rdi=r14, rsi=r8, `call mkfs_format_write_zeros` -- same fail check. Phase 7 (close + success record): sys_close(r14) (SC+ ID 3, return ignored per this repo's fd_close-of-live-fd posture); rdi=rbx, rsi=8 (FR_RESULT_SIGNED_OK, M3 -- was FR_RESULT_OK=0 at M2, since every file-target write is now signed unconditionally), rdx=0, `call mkfs_sp_emit_result`; `xor rax,rax` (MKFS_EXIT_OK); jmp epilogue. Failure paths: mkfs_format_run_encode_fail and mkfs_format_run_sign_fail both set r15 to the sentinel 0xFFFFFFFFFFFFFFFF (neither an encode nor a signing failure has a syscall errno) then fall into mkfs_format_run_close_and_fail; mkfs_format_run_close_fail computes `xor r15,r15; sub r15,rax` (positive errno from the just-failed syscall's negative rax, matching src/user/errno.pdx's syscall_check idiom exactly -- NOT a bare `neg`) then falls into the same close_and_fail; mkfs_format_run_open_fail (no fd yet) computes the same positive-errno idiom directly. mkfs_format_run_close_and_fail: sys_close(r14) best-effort (skipped on the open-fail path, which jumps straight past it since no fd exists); rdi=rbx, rsi=1 (FR_RESULT_FAIL), rdx=r15, `call mkfs_sp_emit_result`; `mov rax,3` (MKFS_EXIT_SYSCALL_ERROR); jmp epilogue. Every call site above either targets a leaf that touches no callee-save register (mkfs_refuse_check touches r12 internally but pushes/pops it; mkfs_format_build_superblock touches rbx/r12 internally as of LV11-024 (#24) but pushes/pops both; mkfs_format_encode_root_inode/pdxb_encode_superblock/pdxb_sign_superblock are all pure leaves per their own documented register plans) or targets mkfs_sp_emit_result/mkfs_format_write_zeros, both of which push/pop every callee-save register they repurpose -- so rbx/r13/r14/r15 all survive every `call` in this function transparently. No `add reg,[mem]` anywhere (`add rdx,696` / `add rdx,10` / `add r15...` are all register-only). No `test` -- every check is `cmp reg,imm`/`cmp reg,0`. No `imul`/`mul` -- the one compile-time-constant multiply (journal bytes = blocks*4096) is `shl r8,12`. Labels prefixed mkfs_format_run_.",
      block: {
        // ---- LV11-025 (#25): stash extension args in .bss BEFORE
        //      pushing callee-save regs. rcx/r8 are SysV caller-save
        //      and would be clobbered by the first `syscall`/`call`;
        //      the .bss slots survive the whole pipeline. ---------------
        mov [rip + mkfs_format_v11_flags], rcx;
        mov [rip + mkfs_format_v11_pfd], r8;

        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = target_ptr
        mov r12, rsi;                       // r12 = force_flag
        mov r13, rdx;                       // r13 = journal_size_blocks

        // ---- Phase 1: non-blank refusal gate. ----------------------------
        mov rdi, rbx;
        mov rsi, r12;
        call mkfs_refuse_check;
        cmp rax, 0;
        je mkfs_format_run_open;

        mov rdi, rbx;
        mov rsi, rax;                       // refusal code == matching FR_RESULT_* code
        xor rdx, rdx;
        call mkfs_sp_emit_result;           // M3 (#10): via src/pipe_wire.pdx, not FormatRecord directly
        mov rax, 5;                         // MKFS_EXIT_REFUSED
        jmp mkfs_format_run_epilogue;

      mkfs_format_run_open:
        // ---- Phase 2: sys_open(target, O_CREAT|O_WRONLY|O_TRUNC, 0644). --
        mov rdi, rbx;
        mov rsi, 0xC1;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        cmp rax, 0;
        jl mkfs_format_run_open_fail;

        mov r14, rax;                       // r14 = fd

        // ---- Phase 3: build + encode + write superblock. -----------------
        mov rdi, r13;
        call mkfs_format_build_superblock;

        // ---- LV11-025 (#25) hook A: summary-level flag/version stamp. ----
        // Iff the caller passed PA_FLAG_ENCRYPT or PA_FLAG_QUOTA_SET, the
        // superblock version bumps to PDXB_VERSION_V2 and the matching
        // PDXB_FLAG_* bit is OR-ed into SBS_OFF_FLAGS. Both helpers are
        // no-ops when their bit is not set (see src/encrypt.pdx and
        // src/quota.pdx for the bodies) -- an M2/M3-shape invocation
        // flows through with no observable change.
        lea rdi, [rip + mkfs_format_sb_summary];
        mov rsi, [rip + mkfs_format_v11_flags];
        call mkfs_encrypt_apply_flag;       // src/encrypt.pdx
        lea rdi, [rip + mkfs_format_sb_summary];
        mov rsi, [rip + mkfs_format_v11_flags];
        call mkfs_quota_apply_flag;         // src/quota.pdx

        lea rdi, [rip + mkfs_format_sb_summary];
        lea rsi, [rip + mkfs_format_sb_encoded];
        mov rdx, 4096;                      // PDXB_ONDISK_BYTES
        call pdxb_encode_superblock;
        cmp rax, 4096;                      // PDXB_ONDISK_BYTES
        jne mkfs_format_run_encode_fail;

        // ---- LV11-025 (#25) hook B: on-disk-buffer encryption stamp. ----
        // Iff PA_FLAG_ENCRYPT is set, mkfs_encrypt_apply_wrap reads the
        // caller's passphrase from mkfs_format_v11_pfd via a real
        // sys_read, derives a KEK, wraps a placeholder all-zero DEK, and
        // stamps wrapped_dek / kdf_salt / wrap_nonce into the on-disk
        // buffer at their PDXB_D_OFF_* offsets (192 / 240 / 256). The
        // helper returns 0 on success, non-zero on any KDF/AEAD failure
        // -- either is treated as a MKFS_EXIT_SYSCALL_ERROR path with a
        // FAIL record via the same close_and_fail epilogue every other
        // pipeline failure uses.
        mov rax, [rip + mkfs_format_v11_flags];
        and rax, 0x80;                      // MKFS_FMT_FLAG_ENCRYPT
        cmp rax, 0;
        je mkfs_format_run_skip_encrypt;

        lea rdi, [rip + mkfs_format_sb_encoded];
        mov rsi, [rip + mkfs_format_v11_pfd];
        call mkfs_encrypt_apply_wrap;       // src/encrypt.pdx
        cmp rax, 0;
        jne mkfs_format_run_encrypt_fail;

      mkfs_format_run_skip_encrypt:
        // ---- Phase 3b (M3, #9): sign the superblock in place. ------------
        lea rdi, [rip + mkfs_format_sb_encoded];
        lea rsi, [rip + mkfs_sign_seed_zero];
        lea rdx, [rip + mkfs_format_sb_encoded];
        add rdx, 696;                       // MKFS_SIGN_SIG_OFFSET (PDXB_D_OFF_SIG)
        mov rcx, 3309;                      // MKFS_SIGN_SIG_LEN (MLDSA65_SIG_LEN)
        call pdxb_sign_superblock;
        cmp rax, 3309;                      // MKFS_SIGN_SIG_LEN
        jne mkfs_format_run_sign_fail;

        mov rdi, r14;
        lea rsi, [rip + mkfs_format_sb_encoded];
        mov rdx, 4096;
        mov rax, 1;
        syscall;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        // ---- Phase 4: inode table (no lseek -- see module header). -------
        mov rdi, r14;
        lea rsi, [rip + mkfs_format_zero_buf];
        mov rdx, 128;
        mov rax, 1;
        syscall;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        call mkfs_format_encode_root_inode;

        mov rdi, r14;
        lea rsi, [rip + mkfs_format_root_inode];
        mov rdx, 128;
        mov rax, 1;
        syscall;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        mov rdi, r14;
        mov rsi, 32512;                     // (256 - 2) * 128
        call mkfs_format_write_zeros;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        // ---- Phase 5: allocator bitmap zeros. -----------------------------
        mov rdi, r14;
        mov rsi, 1024;                      // MKFS_BITMAP_BYTES
        call mkfs_format_write_zeros;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        // ---- Phase 6: journal zeros (blocks -> bytes via shl 12). ---------
        mov r8, r13;
        shl r8, 12;                         // journal_size_blocks * 4096
        mov rdi, r14;
        mov rsi, r8;
        call mkfs_format_write_zeros;
        cmp rax, 0;
        jl mkfs_format_run_close_fail;

        // ---- Phase 7: close + success record. -----------------------------
        mov rdi, r14;
        mov rax, 3;
        syscall;

        mov rdi, rbx;
        mov rsi, 8;                         // FR_RESULT_SIGNED_OK (M3, #9 -- was FR_RESULT_OK at M2)
        xor rdx, rdx;
        call mkfs_sp_emit_result;           // M3 (#10): via src/pipe_wire.pdx, not FormatRecord directly
        xor rax, rax;                       // MKFS_EXIT_OK
        jmp mkfs_format_run_epilogue;

      mkfs_format_run_encode_fail:
        mov r15, 0xFFFFFFFFFFFFFFFF;        // no syscall errno; encode-failure sentinel
        jmp mkfs_format_run_close_and_fail;

      mkfs_format_run_sign_fail:
        mov r15, 0xFFFFFFFFFFFFFFFF;        // no syscall errno; PDXB_SIGN_ERR sentinel (M3, #9)
        jmp mkfs_format_run_close_and_fail;

      mkfs_format_run_encrypt_fail:
        // LV11-025 (#25): mkfs_encrypt_apply_wrap returned non-zero
        // (LPV_CRYPTO_ERR_KDF_FAIL / _AEAD_FAIL / _BAD_KEY_LEN, all
        // in the 0x09xx band -- see libpdx-volume/src/lpv_errors.pdx).
        // Report the raw library error code verbatim through the
        // FAIL record's `error: <n>` slot; a future lpv_strerror wire-in
        // (see src/format_record.pdx's LV11-024 note) will resolve
        // 0x09xx to a human-readable "crypto: kdf fail" / "crypto:
        // aead fail" prefix without any further change here.
        mov r15, rax;
        jmp mkfs_format_run_close_and_fail;

      mkfs_format_run_close_fail:
        xor r15, r15;
        sub r15, rax;                       // positive errno from the failing syscall

      mkfs_format_run_close_and_fail:
        mov rdi, r14;
        mov rax, 3;
        syscall;                            // best-effort close; return ignored

        mov rdi, rbx;
        mov rsi, 1;                         // FR_RESULT_FAIL
        mov rdx, r15;
        call mkfs_sp_emit_result;           // M3 (#10): via src/pipe_wire.pdx, not FormatRecord directly
        mov rax, 3;                         // MKFS_EXIT_SYSCALL_ERROR
        jmp mkfs_format_run_epilogue;

      mkfs_format_run_open_fail:
        xor r15, r15;
        sub r15, rax;                       // positive errno from sys_open

        mov rdi, rbx;
        mov rsi, 1;                         // FR_RESULT_FAIL
        mov rdx, r15;
        call mkfs_sp_emit_result;           // M3 (#10): via src/pipe_wire.pdx, not FormatRecord directly
        mov rax, 3;                         // MKFS_EXIT_SYSCALL_ERROR

      mkfs_format_run_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // mkfs_format_run_device(target_ptr, force_flag, journal_size_blocks) -> u64
  //   (always MKFS_EXIT_DEVICE_STUB -- see module header's "M3-001, #8"
  //   section for why no real write path exists to attempt)
  //
  //   rdi = target_ptr          (the full "cap:blkdev:0xNN" string,
  //                               already classified TARGET_DEVICE_CAP)
  //   rsi = force_flag          (unused by this stub body -- accepted so
  //                               a future real body has it without an
  //                               ABI change)
  //   rdx = journal_size_blocks (unused by this stub body, same reason)
  //
  // Called by src/main.pdx's device-target dispatch only in the (today
  // unreachable, per src/elevate_wire.pdx's module header) GRANT arm --
  // i.e. this function's body has never actually executed against a
  // real invocation at this landing, but it IS real, wired code, not
  // dead code kept for tidiness.
  //
  // Register plan: rbx=target_ptr, held across the one nested call.
  // force_flag/journal_size_blocks are read-only and never referenced
  // again after entry, so they need no register of their own (SysV
  // caller-save rsi/rdx are simply left untouched until the call clobbers
  // them, which is fine since nothing after that point reads them).
  // ==========================================================================
  pub let mkfs_format_run_device : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (target_ptr: u64) (force_flag: u64) (journal_size_blocks: u64) (flags: u64) (passphrase_fd: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "mkfs.pdxfs.M3-001 (#8) + LV11-025 (#25): mkfs_format_run_device entry point, the device-target stub pipeline. `push rbx` before repurposing it. `mov rbx, rdi` (rbx=target_ptr; rsi/rdx -- force_flag/journal_size_blocks -- are accepted per this function's public signature but read by nothing below, per module header). `call mkfs_dev_parse_slot` (src/target.pdx, rdi=rbx already in position) -> rax = the parsed device-cap slot number; this repo's own M3 landing reads no further use of it (no kind-validation syscall exists to check it against, per src/target.pdx's own module header) -- the call is made anyway so a future real body already has the parsed value threaded through without an ABI change. `mov rdi, rbx` (target_ptr), `mov rsi, 5` (FR_RESULT_DEVICE_TARGET_STUB), `xor rdx, rdx` (errno unused), `call mkfs_sp_emit_result` (src/pipe_wire.pdx). `mov rax, 4` (MKFS_EXIT_DEVICE_STUB). `pop rbx; ret`. No `add reg,[mem]`. No `test`. Labels prefixed mkfs_format_rd_ (none needed -- no branch).",
      block: {
        push rbx;

        mov rbx, rdi;                       // rbx = target_ptr

        call mkfs_dev_parse_slot;           // src/target.pdx -- parsed slot, unused further (see justification)

        mov rdi, rbx;
        mov rsi, 5;                          // FR_RESULT_DEVICE_TARGET_STUB
        xor rdx, rdx;
        call mkfs_sp_emit_result;           // src/pipe_wire.pdx

        mov rax, 4;                          // MKFS_EXIT_DEVICE_STUB

        pop rbx;
        ret;
      }
    }
}

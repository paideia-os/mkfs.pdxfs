// src/argv.pdx — mkfs.pdxfs.ENH-030 satellite adoption of libpdx-argv v1.1.0
//
// R90-XREPO satellite cascade, mkfs.pdxfs branch (issue #27):
// replaces the handwritten long-flag scanner this file used through
// v1.1.2 with a thin wire-in over libpdx-argv (paideia-satellites/
// libpdx-argv v1.1.0, ENH-030 rename tag). Every public symbol callers
// depend on -- the `argv_parse` entry point, the `PA_OFF_*` /
// `PA_FLAG_*` / `PA_STRUCT_BYTES` constants, the `argv_quota_specs`
// scratch array and its `ARGV_QUOTA_MAX_ENTRIES` cap -- keeps its
// numeric value and its byte offset unchanged, so `src/main.pdx`'s
// direct-offset loads (`[r14 + 0]` for flags, `[r14 + 32]` for
// target_ptr, etc.) and `tests/test_upgrade_stub.pdx`'s
// `mkfs_test_parsed_argv: [u8; 56]` buffer + `and rax, 0x40`
// PA_FLAG_UPGRADE check both continue to work byte-for-byte.
//
// ----------------------------------------------------------------------
// libpdx-argv wire-in shape
// ----------------------------------------------------------------------
//
// `argv_parse(argc, argv, out_ptr)` now:
//   1. Zero-initialises the caller's 56-byte ParsedArgv scratch struct
//      (journal_size gets its non-zero ARGV_DEFAULT_JOURNAL_SIZE
//      default; every other slot is 0).
//   2. Calls `flag_spec_reset()` to clear libpdx-argv's registration
//      table, then `flag_spec_register()` eleven times -- once per
//      mkfs.pdxfs long flag, binding each name to a value kind
//      (`FKIND_BOOL` / `FKIND_STR` / `FKIND_INT`) and a caller-chosen
//      numeric ID from the FID_* space this module owns.
//   3. Calls `parsed_args_reset()` to clear libpdx-argv's per-parse
//      ParsedArgs bookkeeping.
//   4. Calls `parse_argv(argv+8, argc-1)` -- the +8/-1 pair skips
//      argv[0] (the program name), which libpdx-argv's parser expects
//      the caller to strip because its own loop starts at index 0
//      (empirically established: every existing consumer under
//      paideia-satellites/ that calls parse_argv passes argv+8, argc-1
//      for the same reason). parse_argv's return value is IGNORED --
//      even a soft error (`ERR_MISSING_VALUE` for a typed flag whose
//      value token is missing, `ERR_UNKNOWN_ARG_FORM` for a bare "-",
//      etc.) still leaves libpdx-argv's ParsedArgs singleton populated
//      with everything that WAS parsed up to the failing index, and
//      those partial results are what the shim reads below. This
//      permissive posture matches the pre-shim v1.1.2 body, which
//      silently dropped malformed flags rather than propagating an
//      error out of `argv_parse`.
//   5. Walks `flag_ids[0..flag_count)` from libpdx-argv's ParsedArgs
//      once. Every FID_* case OR's the matching PA_FLAG_* bit into the
//      running flags-mask; the four value-carrying flags (--label /
//      --journal-size / --sig-key / --passphrase-fd) additionally
//      read `flag_values[k]` and store it (or its `parse_int_u64`
//      decode) into the matching PA_OFF_* slot in the caller's out
//      struct. --quota (repeatable) appends every occurrence's value
//      pointer into `argv_quota_specs[..PA_OFF_QUOTA_COUNT]` up to
//      `ARGV_QUOTA_MAX_ENTRIES = 16`, silently dropping any past the
//      cap (matches the pre-shim posture).
//   6. Populates `PA_OFF_TARGET_PTR` from `pos_ptrs[0]` if
//      `pos_count > 0` (mkfs.pdxfs takes exactly one positional; a
//      caller passing two would only see the FIRST here -- a stricter
//      behaviour than the pre-shim "last positional wins" but
//      indistinguishable in practice, since the pre-shim positional
//      loop also stopped consuming after the first non-flag token
//      landed target_ptr and every subsequent match would just
//      overwrite it with another single-positional call anyway).
//   7. Returns `ARGV_OK` when a target was found, else
//      `ARGV_ERR_MISSING_TARGET` -- unchanged surface for main.pdx's
//      early-branch check (which the LV11-025 v1.1.1 fixup already
//      wired to consult PA_FLAG_HELP BEFORE this return code, so a
//      bare `mkfs.pdxfs --help` still prints usage + exits 0 even
//      though argv_parse returns ARGV_ERR_MISSING_TARGET).
//
// ----------------------------------------------------------------------
// FID_* numbering (owned by this module, per the libpdx-argv contract)
// ----------------------------------------------------------------------
//
// libpdx-argv reserves IDs 1..9 for StdVocab's I3 vocabulary and
// documents that "tool-specific ids start at 100" (per StdVocab's
// module header). This shim's IDs start at 100 and are contiguous so
// the walk's `cmp r10, N; jne next` chain reads linearly. Note that
// FID_HELP (104) deliberately COLLIDES numerically with nothing in
// StdVocab (StdVocab's --help is id 1) -- the shim never calls
// StdVocab::register_all, so there is no way for a StdVocab-id and a
// mkfs-id to co-exist in the same flag_ids[] array. Every FID_* is
// > 32 (past libpdx-argv's MAX_FLAGS sentinel), > 9 (past StdVocab),
// and < 256 (well inside cmp reg, imm ≤ 0x7FFFFFFF).
//
// ----------------------------------------------------------------------
// Preserved surface (byte-for-byte with the pre-shim v1.1.2 body)
// ----------------------------------------------------------------------
//
// - PA_OFF_FLAGS = 0, PA_OFF_LABEL_PTR = 8, PA_OFF_JOURNAL_SIZE = 16,
//   PA_OFF_SIG_KEY_PTR = 24, PA_OFF_TARGET_PTR = 32,
//   PA_OFF_PASSPHRASE_FD = 40, PA_OFF_QUOTA_COUNT = 48 --
//   PA_STRUCT_BYTES = 56. Every offset matches the pre-shim layout
//   verbatim, so main.pdx's hard-coded offset loads never move.
// - PA_FLAG_FORCE = 0x1, PA_FLAG_DRY_RUN = 0x2, PA_FLAG_VERBOSE = 0x4,
//   PA_FLAG_LABEL_SET = 0x8, PA_FLAG_JOURNAL_SIZE_SET = 0x10,
//   PA_FLAG_SIG_KEY_SET = 0x20, PA_FLAG_UPGRADE = 0x40,
//   PA_FLAG_ENCRYPT = 0x80, PA_FLAG_PASSPHRASE_FD_SET = 0x100,
//   PA_FLAG_QUOTA_SET = 0x200, PA_FLAG_HELP = 0x400 -- byte-identical
//   bit assignments.
// - ARGV_DEFAULT_JOURNAL_SIZE = 1024 (4 MiB at the frozen 4 KiB
//   block size); argv_parse writes this into PA_OFF_JOURNAL_SIZE when
//   --journal-size is not given.
// - argv_quota_specs: 16-slot .bss reserve (128 bytes for 16 u64
//   slots) fed by every --quota occurrence up to ARGV_QUOTA_MAX_ENTRIES.
// - ARGV_OK = 0, ARGV_ERR_MISSING_TARGET = 1.
// - Bare `mkfs.pdxfs --help` (no positional) still returns
//   ARGV_ERR_MISSING_TARGET; main.pdx's 1.1.1 --help precedence
//   fixup handles it BEFORE branching on the return code.
//
// ----------------------------------------------------------------------
// Behavioural notes vs. the pre-shim body
// ----------------------------------------------------------------------
//
// - `--passphrase-fd` with a missing value: libpdx-argv would report
//   ERR_MISSING_VALUE (typed flag reached end-of-argv with no value
//   token). The shim ignores parse_argv's return code and inspects
//   ParsedArgs post-hoc; libpdx-argv did not store the missing-value
//   flag, so `find_flag_by_id`-equivalent walk never latches
//   PA_FLAG_PASSPHRASE_FD_SET. main.pdx's `--encrypt` requires
//   `--passphrase-fd` gate fires on the same input as before.
// - `--label=value` and `--label value` are BOTH accepted by
//   libpdx-argv (FKIND_STR consumes a lookahead when there is no
//   inline separator). The pre-shim body accepted only the `=` form;
//   the shim is a strict superset. No test relies on refusing the
//   space form.
// - `--journal-size=abc` (malformed numeric): parse_int_u64 returns
//   ok=0. The shim then leaves journal_size at its default value and
//   does NOT latch PA_FLAG_JOURNAL_SIZE_SET. This is a behaviour
//   change vs. the pre-shim body (which stored 0 and latched); no
//   caller consults PA_FLAG_JOURNAL_SIZE_SET, and downstream code
//   uses the journal_size value as-is, so the two behaviours are
//   observationally equivalent for the size==0 case except when a
//   future caller adds a "was this explicitly set?" audit -- flagged
//   for main if a regression surfaces.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline (per project-wide non-negotiable)
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. Byte loads use xor+mov_b per
// paideia-as #1248. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Every `cmp reg, imm` uses imm ≤ 0x7FFFFFFF (max seen:
// 1024 for the journal-size default and 110 for the FID_* cases).
// r11 is scratch (used for every lea to a cross-module .bss base).
// Reserved-label discipline: every label in this file is prefixed
// `mkfs_argv_`.
//
// Upstream: paideia-satellites/libpdx-argv v1.1.0 (ENH-030 rename);
// design/tooling/volume-tooling-ux.md §3.1 (paideia-os, the frozen
// argv surface this shim implements against).

module Argv = structure {

  // --- ParsedArgv out-struct offsets (unchanged from v1.1.2). -----------
  pub let PA_OFF_FLAGS         : u64 = 0
  pub let PA_OFF_LABEL_PTR     : u64 = 8
  pub let PA_OFF_JOURNAL_SIZE  : u64 = 16
  pub let PA_OFF_SIG_KEY_PTR   : u64 = 24
  pub let PA_OFF_TARGET_PTR    : u64 = 32
  pub let PA_OFF_PASSPHRASE_FD : u64 = 40
  pub let PA_OFF_QUOTA_COUNT   : u64 = 48
  pub let PA_STRUCT_BYTES      : u64 = 56

  // --- ParsedArgv.flags bit assignments (unchanged from v1.1.2). --------
  pub let PA_FLAG_FORCE              : u64 = 0x1
  pub let PA_FLAG_DRY_RUN            : u64 = 0x2
  pub let PA_FLAG_VERBOSE            : u64 = 0x4
  pub let PA_FLAG_LABEL_SET          : u64 = 0x8
  pub let PA_FLAG_JOURNAL_SIZE_SET   : u64 = 0x10
  pub let PA_FLAG_SIG_KEY_SET        : u64 = 0x20
  pub let PA_FLAG_UPGRADE            : u64 = 0x40
  pub let PA_FLAG_ENCRYPT            : u64 = 0x80
  pub let PA_FLAG_PASSPHRASE_FD_SET  : u64 = 0x100
  pub let PA_FLAG_QUOTA_SET          : u64 = 0x200
  pub let PA_FLAG_HELP               : u64 = 0x400

  pub let ARGV_DEFAULT_JOURNAL_SIZE : u64 = 1024

  pub let ARGV_OK                    : u64 = 0
  pub let ARGV_ERR_MISSING_TARGET    : u64 = 1

  // --- FID_* numbering (owned by this shim; see module header). ---------
  pub let FID_FORCE          : u64 = 100
  pub let FID_DRY_RUN        : u64 = 101
  pub let FID_VERBOSE        : u64 = 102
  pub let FID_UPGRADE        : u64 = 103
  pub let FID_HELP           : u64 = 104
  pub let FID_ENCRYPT        : u64 = 105
  pub let FID_LABEL          : u64 = 106
  pub let FID_JOURNAL_SIZE   : u64 = 107
  pub let FID_SIG_KEY        : u64 = 108
  pub let FID_PASSPHRASE_FD  : u64 = 109
  pub let FID_QUOTA          : u64 = 110

  // --- Flag-name literals for flag_spec_register (NUL-terminated, no
  //     leading "--" -- libpdx-argv's parser strips the '--' prefix
  //     before invoking FlagSpec::lookup). -------------------------------
  pub let mkfs_argv_name_force         : [u8; 6]  = "force\0"
  pub let mkfs_argv_name_dry_run       : [u8; 8]  = "dry-run\0"
  pub let mkfs_argv_name_verbose       : [u8; 8]  = "verbose\0"
  pub let mkfs_argv_name_upgrade       : [u8; 8]  = "upgrade\0"
  pub let mkfs_argv_name_help          : [u8; 5]  = "help\0"
  pub let mkfs_argv_name_encrypt       : [u8; 8]  = "encrypt\0"
  pub let mkfs_argv_name_label         : [u8; 6]  = "label\0"
  pub let mkfs_argv_name_journal_size  : [u8; 13] = "journal-size\0"
  pub let mkfs_argv_name_sig_key       : [u8; 8]  = "sig-key\0"
  pub let mkfs_argv_name_passphrase_fd : [u8; 14] = "passphrase-fd\0"
  pub let mkfs_argv_name_quota         : [u8; 6]  = "quota\0"

  // --- --quota spec storage (unchanged from v1.1.2). --------------------
  //     16 u64 slots stored as a byte reserve for uniformity with every
  //     other .bss reserve in this codebase. The scale-8 SIB addressing
  //     `[rip + argv_quota_specs + r15*8]` writes each slot as a u64
  //     despite the u8 element type -- same idiom src/format.pdx uses.
  pub let ARGV_QUOTA_MAX_ENTRIES  : u64 = 16
  pub let mut argv_quota_specs    : [u8; 128] = uninit @align(8)

  // ==========================================================================
  // argv_parse(argc, argv, out_ptr) -> u64
  //   rdi = argc  (per the frozen execve ABI)
  //   rsi = argv  (VA of a char*[]; argv[0] is the program name)
  //   rdx = out_ptr (56-byte ParsedArgv struct, caller-allocated .bss)
  //   rax = ARGV_OK (0) on success, ARGV_ERR_MISSING_TARGET (1) if no
  //         positional was seen.
  //
  // Register plan (5 callee-save pushes -> rsp%16 = 0 for nested calls):
  //   rbx = out_ptr        (survives every libpdx-argv call below)
  //   r12 = argc / repurposed after parse_argv to flag_count
  //   r13 = argv / repurposed after parse_argv to loop index i
  //   r14 = accumulated flags mask
  //   r15 = quota_count (running append cursor into argv_quota_specs)
  //
  // Scratch (caller-save; trashed across every call):
  //   rax, rcx, rdx, rdi, rsi, r8, r9, r10, r11
  // ==========================================================================
  pub let argv_parse : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (argc: u64) (argv: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mkfs.pdxfs.ENH-030 (#27): argv_parse shim over libpdx-argv v1.1.0. Entry rsp%16=8 (post-call); pushes 5 callee-save regs (rbx/r12/r13/r14/r15) -> rsp%16=0 for every nested call site (flag_spec_reset, flag_spec_register x11, parsed_args_reset, parse_argv, parse_int_u64 x2). rbx holds the caller's out_ptr through every call; r12 initially holds argc and is repurposed post-parse_argv to hold flag_count for the walk; r13 initially holds argv (needed for the argv+8/argc-1 skip below) and is repurposed post-parse_argv to the walk loop index; r14 accumulates the flags mask across the walk; r15 tracks the quota_count append cursor. Zero-init pass: writes flags=0, label_ptr=0, journal_size=1024 (ARGV_DEFAULT_JOURNAL_SIZE), sig_key_ptr=0, target_ptr=0, passphrase_fd=0, quota_count=0 into the 56-byte out struct BEFORE any libpdx-argv call, so a caller supplying zero flags still gets well-defined defaults (including the non-zero journal_size default). Registration pass: eleven flag_spec_register calls -- (force,BOOL,100), (dry-run,BOOL,101), (verbose,BOOL,102), (upgrade,BOOL,103), (help,BOOL,104), (encrypt,BOOL,105), (label,STR,106), (journal-size,INT,107), (sig-key,STR,108), (passphrase-fd,INT,109), (quota,STR,110). FKIND_BOOL/STR/INT constants are 0/1/2 per libpdx-argv/src/flag_spec.pdx. Parse: rdi=r13+8 (argv+8 skips argv[0], per libpdx-argv's caller-strips-argv0 convention that every existing consumer under paideia-satellites/ follows), rsi=r12-1 (argc-1); call parse_argv. Return code IGNORED -- libpdx-argv's ParsedArgs singleton still holds every flag that WAS parsed even on a soft error (ERR_MISSING_VALUE for --passphrase-fd with no value; ERR_UNKNOWN_ARG_FORM for a bare `-`), and the walk below simply picks up whatever landed. Walk pass: r12=[flag_count], r13=0 (loop index i), r14=0 (accumulated flags), r15=0 (quota_count). Each iteration: r10=flag_ids[r13]; cmp against every FID_* constant in ascending order; on a match, either OR the matching PA_FLAG_* into r14 (for the six booleans FID_FORCE..FID_ENCRYPT) or read flag_values[r13] and store it into the matching PA_OFF_* slot in the out struct (for the five value-carrying flags). --label / --sig-key store the raw string pointer verbatim; --journal-size / --passphrase-fd pipe the string pointer through parse_int_u64 (Typed::parse_int_u64 return convention: rax=ok, rdx=val) and store rdx iff rax==1 -- a parse failure leaves the default in place (a behaviour change vs. the pre-shim `argv_parse_u64_dec` which returned partial values; no caller consults PA_FLAG_*_SET for these two flags, so observationally equivalent). --quota (repeatable) OR's PA_FLAG_QUOTA_SET into r14 unconditionally on every match (matching the pre-shim latch-regardless-of-drop posture), then appends flag_values[r13] into argv_quota_specs[r15] iff r15 < ARGV_QUOTA_MAX_ENTRIES (16) -- an occurrence past the cap is silently dropped, again matching pre-shim. Post-walk: writes r14 into PA_OFF_FLAGS (+0) and r15 into PA_OFF_QUOTA_COUNT (+48). Positional pass: reads pos_count; if > 0, copies pos_ptrs[0] into PA_OFF_TARGET_PTR (+32) -- mkfs.pdxfs takes exactly one positional per its own CLI grammar. Sets rax=ARGV_OK on target seen, ARGV_ERR_MISSING_TARGET on no positional -- unchanged surface for main.pdx's early-branch dispatch. Epilogue pops r15/r14/r13/r12/rbx (reverse push order) then rets. No `add reg,[mem]`; no `test` mnemonic; every cmp reg,imm well under 0x7FFFFFFF (max 1024 for the default). Labels prefixed mkfs_argv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdx;                       // rbx = out_ptr
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Zero-init pass (+ journal-size default). --------------------
        xor rax, rax;
        mov [rbx + 0], rax;                 // flags = 0
        mov [rbx + 8], rax;                 // label_ptr = 0
        mov rax, 1024;                      // ARGV_DEFAULT_JOURNAL_SIZE
        mov [rbx + 16], rax;                // journal_size = default
        xor rax, rax;
        mov [rbx + 24], rax;                // sig_key_ptr = 0
        mov [rbx + 32], rax;                // target_ptr = 0
        mov [rbx + 40], rax;                // passphrase_fd = 0
        mov [rbx + 48], rax;                // quota_count = 0

        // ---- Register the 11 flags with libpdx-argv's FlagSpec. ---------
        call flag_spec_reset;

        lea rdi, [rip + mkfs_argv_name_force];
        mov rsi, 0;                         // FKIND_BOOL
        mov rdx, 100;                       // FID_FORCE
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_dry_run];
        mov rsi, 0;
        mov rdx, 101;                       // FID_DRY_RUN
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_verbose];
        mov rsi, 0;
        mov rdx, 102;                       // FID_VERBOSE
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_upgrade];
        mov rsi, 0;
        mov rdx, 103;                       // FID_UPGRADE
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_help];
        mov rsi, 0;
        mov rdx, 104;                       // FID_HELP
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_encrypt];
        mov rsi, 0;
        mov rdx, 105;                       // FID_ENCRYPT
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_label];
        mov rsi, 1;                         // FKIND_STR
        mov rdx, 106;                       // FID_LABEL
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_journal_size];
        mov rsi, 2;                         // FKIND_INT
        mov rdx, 107;                       // FID_JOURNAL_SIZE
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_sig_key];
        mov rsi, 1;                         // FKIND_STR
        mov rdx, 108;                       // FID_SIG_KEY
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_passphrase_fd];
        mov rsi, 2;                         // FKIND_INT
        mov rdx, 109;                       // FID_PASSPHRASE_FD
        call flag_spec_register;

        lea rdi, [rip + mkfs_argv_name_quota];
        mov rsi, 1;                         // FKIND_STR
        mov rdx, 110;                       // FID_QUOTA
        call flag_spec_register;

        // ---- Reset ParsedArgs bookkeeping + drive the parse. ------------
        call parsed_args_reset;

        mov rdi, r13;
        add rdi, 8;                         // argv+8 (skip argv[0])
        mov rsi, r12;
        sub rsi, 1;                         // argc-1
        call parse_argv;
        // rax = error code; deliberately IGNORED -- populate what landed.

        // ---- Walk flag_ids[0..flag_count) once. -------------------------
        lea r11, [rip + flag_count];
        mov r12, [r11];                     // r12 = flag_count (repurposed)
        xor r13, r13;                       // r13 = i = 0 (repurposed)
        xor r14, r14;                       // r14 = flags mask = 0
        xor r15, r15;                       // r15 = quota_count = 0

      mkfs_argv_walk_loop:
        cmp r13, r12;
        jge mkfs_argv_walk_done;

        lea r11, [rip + flag_ids];
        mov r10, [r11 + r13*8];             // r10 = flag_ids[i]

        cmp r10, 100;                       // FID_FORCE
        jne mkfs_argv_case_dry_run;
        or r14, 0x1;                        // PA_FLAG_FORCE
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_dry_run:
        cmp r10, 101;                       // FID_DRY_RUN
        jne mkfs_argv_case_verbose;
        or r14, 0x2;                        // PA_FLAG_DRY_RUN
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_verbose:
        cmp r10, 102;                       // FID_VERBOSE
        jne mkfs_argv_case_upgrade;
        or r14, 0x4;                        // PA_FLAG_VERBOSE
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_upgrade:
        cmp r10, 103;                       // FID_UPGRADE
        jne mkfs_argv_case_help;
        or r14, 0x40;                       // PA_FLAG_UPGRADE
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_help:
        cmp r10, 104;                       // FID_HELP
        jne mkfs_argv_case_encrypt;
        or r14, 0x400;                      // PA_FLAG_HELP
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_encrypt:
        cmp r10, 105;                       // FID_ENCRYPT
        jne mkfs_argv_case_label;
        or r14, 0x80;                       // PA_FLAG_ENCRYPT
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_label:
        cmp r10, 106;                       // FID_LABEL
        jne mkfs_argv_case_journal_size;
        lea r11, [rip + flag_values];
        mov r9, [r11 + r13*8];              // r9 = value ptr
        mov [rbx + 8], r9;                  // label_ptr
        or r14, 0x8;                        // PA_FLAG_LABEL_SET
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_journal_size:
        cmp r10, 107;                       // FID_JOURNAL_SIZE
        jne mkfs_argv_case_sig_key;
        lea r11, [rip + flag_values];
        mov rdi, [r11 + r13*8];
        call parse_int_u64;                 // rax=ok, rdx=val
        cmp rax, 0;
        je mkfs_argv_walk_next;             // parse fail: leave default
        mov [rbx + 16], rdx;                // journal_size
        or r14, 0x10;                       // PA_FLAG_JOURNAL_SIZE_SET
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_sig_key:
        cmp r10, 108;                       // FID_SIG_KEY
        jne mkfs_argv_case_passphrase_fd;
        lea r11, [rip + flag_values];
        mov r9, [r11 + r13*8];
        mov [rbx + 24], r9;                 // sig_key_ptr
        or r14, 0x20;                       // PA_FLAG_SIG_KEY_SET
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_passphrase_fd:
        cmp r10, 109;                       // FID_PASSPHRASE_FD
        jne mkfs_argv_case_quota;
        lea r11, [rip + flag_values];
        mov rdi, [r11 + r13*8];
        call parse_int_u64;                 // rax=ok, rdx=val
        cmp rax, 0;
        je mkfs_argv_walk_next;             // parse fail: no latch
        mov [rbx + 40], rdx;                // passphrase_fd
        or r14, 0x100;                      // PA_FLAG_PASSPHRASE_FD_SET
        jmp mkfs_argv_walk_next;

      mkfs_argv_case_quota:
        cmp r10, 110;                       // FID_QUOTA
        jne mkfs_argv_walk_next;
        or r14, 0x200;                      // PA_FLAG_QUOTA_SET (latches regardless of drop)
        cmp r15, 16;                        // ARGV_QUOTA_MAX_ENTRIES
        jge mkfs_argv_walk_next;
        lea r11, [rip + flag_values];
        mov r9, [r11 + r13*8];
        lea r11, [rip + argv_quota_specs];
        mov [r11 + r15*8], r9;
        add r15, 1;

      mkfs_argv_walk_next:
        add r13, 1;
        jmp mkfs_argv_walk_loop;

      mkfs_argv_walk_done:
        mov [rbx + 0], r14;                 // flags
        mov [rbx + 48], r15;                // quota_count

        // ---- Positional pass: pos_ptrs[0] -> target_ptr. ----------------
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 0;
        je mkfs_argv_no_target;

        lea r11, [rip + pos_ptrs];
        mov r9, [r11];                      // pos_ptrs[0]
        mov [rbx + 32], r9;                 // target_ptr

        xor rax, rax;                       // ARGV_OK
        jmp mkfs_argv_epilogue;

      mkfs_argv_no_target:
        mov rax, 1;                         // ARGV_ERR_MISSING_TARGET

      mkfs_argv_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}

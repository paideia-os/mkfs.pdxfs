// src/main.pdx — mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3) + M2 (#4) —
// _start
//
// mkfs.pdxfs is a standalone ring-3 ELF, not a library: this file is
// its `_start` entry point, argv-wired per the frozen execve ABI
// (design/user/execve-abi.md in the paideia-os monorepo):
//
//   rdi = argc, rsi = argv (VA of a char*[], own-address-space
//   pointers -- no walker or syscall needed to dereference argv[i]),
//   rdx = envp (unused by this tool), rsp % 16 == 0 at entry.
//
// M3 flow (mkfs.pdxfs.M3, issues #8-#12 -- supersedes the M2-001 flow
// this header previously described; see git history / STATUS.md for
// the M1/M2 shape):
//
//   1. Parse argv via Argv::argv_parse (src/argv.pdx, #2). On
//      ARGV_ERR_MISSING_TARGET, print a usage diagnostic to fd 2 and
//      exit 2 -- UNCHANGED from M1/M2. No audit record is opened for
//      this path (the target string itself is unknown, so there is
//      nothing meaningful to audit yet).
//   2. NEW at M3 (#11): call AuditWire::mkfs_audit_begin(target_ptr,
//      force_flag) (src/audit_wire.pdx) and hold its return value
//      (an audit_id, or 0 -- see that file's own "forgiving posture"
//      note) in r12 for the rest of _start. This happens BEFORE target
//      classification, so every classification outcome (file, device,
//      invalid) gets the same audit wrapping.
//   3. Classify the target via Target::target_classify (src/target.pdx,
//      UNCHANGED at M3).
//   4. TARGET_FILE + --dry-run set: call PipeWire::mkfs_sp_emit_dry_run
//      (src/pipe_wire.pdx, M3 #10 -- replaces the M1/M2 direct call to
//      FormatRecord::format_record_emit_dry_run) to print the preview
//      line, commit the audit record (exit_status=0), then exit 0. No
//      write of any kind happens on this path.
//   5. TARGET_FILE + --dry-run NOT set: call Format::mkfs_format_run
//      (src/format.pdx, M2 #5/#6/#7, extended at M3 #9 to sign every
//      superblock) with (target_ptr, force_flag, journal_size). Its u64
//      return value IS the process exit status; commit the audit record
//      with that value, then sys_exit it unchanged.
//   6. NEW at M3 (#8, #12): TARGET_DEVICE_CAP no longer falls straight to
//      "not yet implemented". Instead: call
//      ElevateWire::mkfs_elev_require_device_write(target_ptr, dev_slot)
//      (src/elevate_wire.pdx) -- dev_slot comes from
//      Target::mkfs_dev_parse_slot (src/target.pdx). On MKFS_ELEV_DENY
//      (the ONLY value this landing's elevate_wire body can ever
//      produce -- see that file's own header): emit
//      PdxFsFormatRecord@0.1 { result_code: ELEVATION_DENIED } via
//      PipeWire::mkfs_sp_emit_result, commit the audit record with
//      MKFS_EXIT_ELEVATION_DENIED (6), and exit non-zero. On
//      MKFS_ELEV_GRANT (real, wired, but unreachable at this landing):
//      call Format::mkfs_format_run_device (src/format.pdx, M3 #8 --
//      itself a documented stub emitting DEVICE_TARGET_STUB), commit,
//      and exit its return value.
//   7. TARGET_INVALID: unchanged "not yet implemented" diagnostic, now
//      ALSO wrapped in an audit commit (exit_status=1) before exiting.
//
// ----------------------------------------------------------------------
// Register plan
// ----------------------------------------------------------------------
//
// All callee-save (SysV rbx/r12-r15), so they survive every nested
// `call` without any push/pop -- each callee clobbers only caller-save
// registers, or explicitly preserves callee-save registers itself via
// its own push/pop (design/architecture.md §7), and SYSCALL preserves
// callee-save registers by the amd64 fast-syscall convention:
//
//   r12 = argc, THEN (M3, from mkfs_main_argv_ok onward) reused to hold
//         the audit_id returned by AuditWire::mkfs_audit_begin -- argc
//         is dead after Phase 1's `call argv_parse`, so this reuse is
//         safe and needs no extra register. r12 is never overwritten
//         again after that single assignment -- every branch reads it
//         once, right before its own `call mkfs_audit_commit`.
//   r13 = argv, THEN (M3, device-target branch only) reused first to
//         hold the parsed device-cap slot number (Target::
//         mkfs_dev_parse_slot's return value) and then, in that same
//         branch, the process exit status -- both uses are dead by the
//         time the next write to r13 happens, so this is a plain
//         scratch-variable reuse, not concurrent aliasing. The
//         file-target branch also stashes its own exit status
//         (Format::mkfs_format_run's return value) in r13 for the same
//         reason (it must survive past the `call mkfs_audit_commit`
//         that needs it a second time for `sys_exit`).
//   r14 = &mkfs_argv_out (the ParsedArgv scratch struct, lea'd once)
//   rbx = ParsedArgv.flags (loaded once after argv_parse succeeds)
//   r15 = ParsedArgv.target_ptr (loaded once after argv_parse succeeds)
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `mkfs_main_`.
//
// SC+ IDs used (same frozen ordinals every src/user/*.pdx binary in the
// paideia-os monorepo uses): 1 = sys_write(fd, buf, count), 60 =
// sys_exit(status).
//
// Upstream: design/tooling/volume-tooling-ux.md §3 (paideia-os);
// design/user/execve-abi.md (paideia-os, the frozen argv ABI this
// _start consumes).

module Main = structure {

  // --- ParsedArgv scratch struct (Argv::PA_STRUCT_BYTES = 40 bytes). ------
  // .bss, zero-initialised by the loader before _start runs; argv_parse
  // additionally writes every field explicitly (including the
  // journal_size default) so this function never reads stale/uninit
  // bytes even on a build where .bss zero-init were somehow skipped.
  pub let mut mkfs_argv_out : [u8; 40] = uninit @align(8)

  // --- Diagnostic messages (fd 2). -----------------------------------------
  pub let mkfs_msg_missing_target     : [u8; 28] = "mkfs.pdxfs: missing target\n\0"
  pub let mkfs_msg_missing_target_len : u64 = 27

  pub let mkfs_msg_not_implemented     : [u8; 33] = "mkfs.pdxfs: not yet implemented\n\0"
  pub let mkfs_msg_not_implemented_len : u64 = 32

  // ==========================================================================
  // _start -- user program entry point. Never returns (every terminal
  // path ends in sys_exit).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3) + M2-001 (#4) + M3 (#8, #9, #10, #11, #12): mkfs.pdxfs _start. Stashes argc (rdi) into r12 and argv (rsi) into r13 immediately (both SysV callee-save) so they survive the `call argv_parse` below. Phase 1: rdi=r12, rsi=r13, rdx=&mkfs_argv_out (rip-relative lea), call argv_parse (src/argv.pdx, #2). On a non-zero return (ARGV_ERR_MISSING_TARGET), jump to the missing-target path: sys_write(2, mkfs_msg_missing_target, 27), sys_exit(2) -- UNCHANGED from M1/M2; no audit record is opened for this path (see module header). Phase 2 (on ARGV_OK, mkfs_main_argv_ok): r14 = &mkfs_argv_out (rip-relative lea, held for the rest of _start); rbx = [r14+0] (ParsedArgv.flags); r15 = [r14+32] (ParsedArgv.target_ptr). NEW at M3 (#11): rdi=r15 (target_ptr), rax=rbx&0x1 (PA_FLAG_FORCE) moved into rsi (force_flag), `call mkfs_audit_begin` (src/audit_wire.pdx) -> rax=audit_id; `mov r12, rax` (r12 reused from the now-dead argc, see module header's register plan). Gate 1 (classify): rdi=r15; call target_classify (src/target.pdx, UNCHANGED); `cmp rax,0; je mkfs_main_target_file` (Target::TARGET_FILE); `cmp rax,1; je mkfs_main_target_device` (Target::TARGET_DEVICE_CAP, NEW at M3 -- no longer falls straight through); any other value (Target::TARGET_INVALID) falls through to `jmp mkfs_main_not_implemented`. mkfs_main_target_file: Gate 2, rax=rbx&0x2 (PA_FLAG_DRY_RUN); `cmp rax,0; je mkfs_main_file_real` when NOT given. When --dry-run WAS given: rdi=r15, rsi=[r14+8] (label_ptr), rdx=[r14+16] (journal_size); `call mkfs_sp_emit_dry_run` (src/pipe_wire.pdx, M3 #10 -- replaces the M1/M2 direct call to format_record_emit_dry_run) -- prints the deferred-header line then the M1 four-field preview line; rdi=r12 (audit_id), xor rsi,rsi (exit_status=0), `call mkfs_audit_commit` (src/audit_wire.pdx); xor rdi,rdi; sys_exit(0). mkfs_main_file_real: rdi=r15, rax=rbx&0x1 (force_flag), rdx=[r14+16] (journal_size); `call mkfs_format_run` (src/format.pdx, M2 #5/#6/#7, extended M3 #9 to sign) -> rax=exit_status; `mov r13, rax` (stashed -- r13, argv, is dead by this point, see module header); rdi=r12, rsi=r13, `call mkfs_audit_commit`; rdi=r13; sys_exit(r13). mkfs_main_target_device (NEW at M3, #8/#12): rdi=r15, `call mkfs_dev_parse_slot` (src/target.pdx) -> rax=dev_slot; `mov r13, rax` (stashed). rdi=r15, rsi=r13, `call mkfs_elev_require_device_write` (src/elevate_wire.pdx) -> rax in {MKFS_ELEV_DENY=0, MKFS_ELEV_GRANT=1}; `cmp rax,1; je mkfs_main_device_grant`. DENY (the only value this landing's elevate_wire body can ever produce -- see that file's own header): rdi=r15, mov rsi,6 (FR_RESULT_ELEVATION_DENIED), xor rdx,rdx, `call mkfs_sp_emit_result` (src/pipe_wire.pdx); `mov r13, 6` (MKFS_EXIT_ELEVATION_DENIED, r13's dev_slot value is dead by this point -- reused as a plain scratch slot, see module header); rdi=r12, rsi=r13, `call mkfs_audit_commit`; rdi=r13; sys_exit(6). mkfs_main_device_grant (real, wired, unreachable at this landing): rdi=r15, rax=rbx&0x1 (force_flag), rdx=[r14+16] (journal_size); `call mkfs_format_run_device` (src/format.pdx, M3 #8, a documented stub) -> rax=exit_status; `mov r13, rax`; rdi=r12, rsi=r13, `call mkfs_audit_commit`; rdi=r13; sys_exit(r13). mkfs_main_not_implemented: sys_write(2, mkfs_msg_not_implemented, 32); rdi=r12, mov rsi,1, `call mkfs_audit_commit` (NEW at M3 -- this path is now also audit-wrapped, since audit_begin already ran unconditionally in Phase 2); sys_exit(1). Every terminal path ends in sys_exit (never returns); a trailing hlt on each path is defensive belt-and-suspenders, matching every other _start in the paideia-os monorepo's src/user/ tree. target_classify/mkfs_dev_parse_slot/mkfs_elev_require_device_write are pure/self-preserving per their own justifications; mkfs_format_run/mkfs_format_run_device/mkfs_sp_emit_dry_run/mkfs_sp_emit_result/mkfs_audit_begin/mkfs_audit_commit all either touch only caller-save registers or explicitly preserve every callee-save register they repurpose (design/architecture.md §7) -- so rbx/r14/r15 (and r12/r13 once assigned their M3 roles) all survive every call in this function transparently, needing no push/pop here. No `add reg,[mem]`; every zero-check is cmp reg, 0 (no `test` mnemonic). Labels prefixed mkfs_main_.",
      block: {
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Phase 1: parse argv. ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + mkfs_argv_out];
        call argv_parse;

        cmp rax, 0;                          // ARGV_OK
        je mkfs_main_argv_ok;

        // ---- ARGV_ERR_MISSING_TARGET ---------------------------------------
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_missing_target];
        mov rdx, 27;                         // mkfs_msg_missing_target_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_argv_ok:
        lea r14, [rip + mkfs_argv_out];      // r14 = &ParsedArgv

        mov rbx, [r14 + 0];                  // rbx = flags (Argv::PA_OFF_FLAGS)
        mov r15, [r14 + 32];                 // r15 = target_ptr (Argv::PA_OFF_TARGET_PTR)

        // ---- M3 (#11): open the audit record before any dispatch. --------
        mov rdi, r15;                        // target_ptr
        mov rax, rbx;
        and rax, 0x1;                        // Argv::PA_FLAG_FORCE
        mov rsi, rax;                        // force_flag
        call mkfs_audit_begin;
        mov r12, rax;                        // r12 = audit_id (argc is dead; see module header)

        // ---- Gate 1: classify target. -------------------------------------
        mov rdi, r15;
        call target_classify;
        cmp rax, 0;                          // Target::TARGET_FILE
        je mkfs_main_target_file;
        cmp rax, 1;                          // Target::TARGET_DEVICE_CAP
        je mkfs_main_target_device;
        jmp mkfs_main_not_implemented;        // Target::TARGET_INVALID

      mkfs_main_target_file:
        // ---- Gate 2: --dry-run set? (Argv::PA_FLAG_DRY_RUN = 0x2) ---------
        mov rax, rbx;
        and rax, 0x2;
        cmp rax, 0;
        je mkfs_main_file_real;

        // ---- --dry-run + TARGET_FILE: preview path, via pipe_wire. --------
        mov rdi, r15;                        // target_ptr
        mov rsi, [r14 + 8];                  // label_ptr (Argv::PA_OFF_LABEL_PTR)
        mov rdx, [r14 + 16];                 // journal_size (Argv::PA_OFF_JOURNAL_SIZE)
        call mkfs_sp_emit_dry_run;            // src/pipe_wire.pdx (M3, #10)

        mov rdi, r12;                        // audit_id
        xor rsi, rsi;                        // exit_status = 0
        call mkfs_audit_commit;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_file_real:
        // ---- M2 (#4/#5/#6/#7), extended M3 (#9) to sign: real write path. -
        mov rdi, r15;                        // target_ptr
        mov rax, rbx;
        and rax, 0x1;                        // Argv::PA_FLAG_FORCE
        mov rsi, rax;                        // force_flag (0 or 1)
        mov rdx, [r14 + 16];                 // journal_size (blocks)
        call mkfs_format_run;

        mov r13, rax;                        // exit_status (argv is dead; see module header)
        mov rdi, r12;                        // audit_id
        mov rsi, r13;
        call mkfs_audit_commit;

        mov rdi, r13;
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_target_device:
        // ---- M3 (#8, #12): device-cap target path. ------------------------
        mov rdi, r15;                        // target_ptr
        call mkfs_dev_parse_slot;             // src/target.pdx
        mov r13, rax;                        // r13 = dev_slot

        mov rdi, r15;                        // target_ptr
        mov rsi, r13;                        // dev_slot
        call mkfs_elev_require_device_write;  // src/elevate_wire.pdx
        cmp rax, 1;                          // MKFS_ELEV_GRANT
        je mkfs_main_device_grant;

        // ---- MKFS_ELEV_DENY (the only value reachable at this landing). --
        mov rdi, r15;                        // target_ptr
        mov rsi, 6;                          // FR_RESULT_ELEVATION_DENIED
        xor rdx, rdx;
        call mkfs_sp_emit_result;             // src/pipe_wire.pdx

        mov r13, 6;                          // MKFS_EXIT_ELEVATION_DENIED (dev_slot now dead)
        mov rdi, r12;                        // audit_id
        mov rsi, r13;
        call mkfs_audit_commit;

        mov rdi, r13;
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_device_grant:
        // ---- Real, wired, unreachable at this landing -- see
        //      src/elevate_wire.pdx's module header. ------------------------
        mov rdi, r15;                        // target_ptr
        mov rax, rbx;
        and rax, 0x1;                        // Argv::PA_FLAG_FORCE
        mov rsi, rax;                        // force_flag
        mov rdx, [r14 + 16];                 // journal_size (blocks)
        call mkfs_format_run_device;          // src/format.pdx (M3, #8)

        mov r13, rax;                        // exit_status
        mov rdi, r12;                        // audit_id
        mov rsi, r13;
        call mkfs_audit_commit;

        mov rdi, r13;
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_not_implemented:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_not_implemented];
        mov rdx, 32;                         // mkfs_msg_not_implemented_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, r12;                        // audit_id (M3: this path is now audit-wrapped too)
        mov rsi, 1;                          // exit_status
        call mkfs_audit_commit;

        mov rdi, 1;                          // status = 1
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    }
}

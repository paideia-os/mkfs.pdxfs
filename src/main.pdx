// src/main.pdx — mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3) + M2 (#4) —
// _start
//
// mkfs.pdxfs is a standalone ring-3 ELF, not a library: this file is
// its `_start` entry point, argv-wired per the frozen execve ABI
// (design/user/execve-abi.md in the paideia-os monorepo):
//
//   rdi = argc, rsi = argv (VA of a char*[], own-address-space
//   pointers -- no walker or syscall needed to dereference argv[i]),
//   rdx = envp (unused by this tool), rsp % 16 == 0 at entry.
//
// M2 flow (mkfs.pdxfs.M2-001, issue #4 -- supersedes the M1-003 flow
// this header previously described; see git history / STATUS.md for
// the M1 shape):
//
//   1. Parse argv via Argv::argv_parse (src/argv.pdx, #2). On
//      ARGV_ERR_MISSING_TARGET, print a usage diagnostic to fd 2 and
//      exit 2 (matches design/tooling/volume-tooling-ux.md §3.2's
//      "Any other prefix is a parse error (exit 2, invalid argument)"
//      convention -- a missing positional is the same class of misuse).
//   2. Classify the target via Target::target_classify (src/target.pdx).
//      A non-TARGET_FILE result (device-cap or invalid prefix) falls
//      straight through to the "not yet implemented" diagnostic + exit
//      1, REGARDLESS of --dry-run -- the device-cap path is
//      mkfs.pdxfs.M3-001, still not implemented (see target.pdx's own
//      header for why this is unchanged from M1).
//   3. TARGET_FILE + --dry-run set: unchanged M1 behavior -- call
//      FormatRecord::format_record_emit_dry_run (src/format_record.pdx,
//      #3) to print the M1 four-field PdxFsFormatRecord@0.1 preview
//      line, then exit 0. No write of any kind happens on this path.
//   4. TARGET_FILE + --dry-run NOT set: the NEW M2 real-write path.
//      Call Format::mkfs_format_run (src/format.pdx, #5/#6/#7) with
//      (target_ptr, force_flag, journal_size) -- it runs the non-blank
//      refusal gate, then (if not refused) the real superblock/inode-
//      table/bitmap/journal write pipeline, emitting the terminal
//      PdxFsFormatRecord@0.1 (OK / a REFUSED_* variant / FAIL) itself.
//      Its u64 return value IS the process exit status (0, 3, or 5 per
//      design/tooling/volume-tooling-ux.md's exit-code contract) --
//      passed to sys_exit unchanged, no further branching needed here.
//
// ----------------------------------------------------------------------
// Register plan
// ----------------------------------------------------------------------
//
// All callee-save (SysV rbx/r12-r15), so they survive every nested
// `call` (argv_parse, target_classify, format_record_emit_dry_run,
// mkfs_format_run) without any push/pop -- each callee clobbers only
// caller-save registers, or explicitly preserves callee-save registers
// itself via its own push/pop (mkfs_format_run does, per
// design/architecture.md §7), and SYSCALL preserves callee-save
// registers by the amd64 fast-syscall convention:
//
//   r12 = argc (saved immediately from rdi, before any call)
//   r13 = argv (saved immediately from rsi)
//   r14 = &mkfs_argv_out (the ParsedArgv scratch struct, lea'd once)
//   rbx = ParsedArgv.flags (loaded once after argv_parse succeeds)
//   r15 = ParsedArgv.target_ptr (loaded once after argv_parse succeeds)
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `mkfs_main_`.
//
// SC+ IDs used (same frozen ordinals every src/user/*.pdx binary in the
// paideia-os monorepo uses): 1 = sys_write(fd, buf, count), 60 =
// sys_exit(status).
//
// Upstream: design/tooling/volume-tooling-ux.md §3 (paideia-os);
// design/user/execve-abi.md (paideia-os, the frozen argv ABI this
// _start consumes).

module Main = structure {

  // --- ParsedArgv scratch struct (Argv::PA_STRUCT_BYTES = 40 bytes). ------
  // .bss, zero-initialised by the loader before _start runs; argv_parse
  // additionally writes every field explicitly (including the
  // journal_size default) so this function never reads stale/uninit
  // bytes even on a build where .bss zero-init were somehow skipped.
  pub let mut mkfs_argv_out : [u8; 40] = uninit @align(8)

  // --- Diagnostic messages (fd 2). -----------------------------------------
  pub let mkfs_msg_missing_target     : [u8; 28] = "mkfs.pdxfs: missing target\n\0"
  pub let mkfs_msg_missing_target_len : u64 = 27

  pub let mkfs_msg_not_implemented     : [u8; 33] = "mkfs.pdxfs: not yet implemented\n\0"
  pub let mkfs_msg_not_implemented_len : u64 = 32

  // ==========================================================================
  // _start -- user program entry point. Never returns (every terminal
  // path ends in sys_exit).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3) + M2-001 (#4): mkfs.pdxfs _start. Stashes argc (rdi) into r12 and argv (rsi) into r13 immediately (both SysV callee-save) so they survive the `call argv_parse` below. Phase 1: rdi=r12, rsi=r13, rdx=&mkfs_argv_out (rip-relative lea), call argv_parse (src/argv.pdx, #2). On a non-zero return (ARGV_ERR_MISSING_TARGET), jump to mkfs_main_missing_target: sys_write(2, mkfs_msg_missing_target, 27), sys_exit(2) -- exit code 2 matches design/tooling/volume-tooling-ux.md §3.2's 'parse error (exit 2, invalid argument)' convention for a malformed invocation, extended here to cover a missing positional as the same misuse class. Phase 2 (on ARGV_OK): r14 = &mkfs_argv_out (rip-relative lea, held for the rest of _start); rbx = [r14+0] (ParsedArgv.flags, Argv::PA_OFF_FLAGS); r15 = [r14+32] (ParsedArgv.target_ptr, Argv::PA_OFF_TARGET_PTR). Gate 1 (M2, unconditional on --dry-run): rdi=r15; call target_classify (src/target.pdx); cmp rax,0 (Target::TARGET_FILE); jne mkfs_main_not_implemented -- a device-cap or invalid target falls straight to 'not yet implemented' + exit 1 regardless of --dry-run (mkfs.pdxfs.M3-001 still owns the device-cap path; see target.pdx's own header). Gate 2 (only reached for TARGET_FILE): rax = rbx & 0x2 (Argv::PA_FLAG_DRY_RUN); cmp rax,0; je mkfs_main_file_real when --dry-run was NOT given -- branches into the NEW M2 real-write path. When --dry-run WAS given: rdi=r15 (target_ptr), rsi=[r14+8] (label_ptr), rdx=[r14+16] (journal_size); call format_record_emit_dry_run (src/format_record.pdx, #3, UNCHANGED from M1) -- prints the M1 four-field preview line to fd 1; sys_exit(0). mkfs_main_file_real (the M2-001/#4 real-write path): rdi=r15 (target_ptr); rax=rbx & 0x1 (Argv::PA_FLAG_FORCE), rsi=rax (force_flag, reduced to a single 0/1 bit); rdx=[r14+16] (journal_size, already in BLOCKS per argv_parse's own documented default); call mkfs_format_run (src/format.pdx, #5/#6/#7) -- runs the refusal gate then (if not refused) the real write pipeline, emitting its own terminal PdxFsFormatRecord@0.1 and returning the process exit status (0 OK / 3 SYSCALL_ERROR / 5 REFUSED) directly in rax; mov rdi,rax; sys_exit(rdi) -- no further branching needed, mkfs_format_run's return value IS the exit status verbatim. mkfs_main_not_implemented: sys_write(2, mkfs_msg_not_implemented, 32), sys_exit(1) -- now reached only for a device-cap or invalid target (mkfs.pdxfs.M3-001), independent of --dry-run. Every terminal path ends in sys_exit (never returns); a trailing hlt on each path is defensive belt-and-suspenders for the impossible fallthrough, matching every other _start in the paideia-os monorepo's src/user/ tree. target_classify, format_record_emit_dry_run are pure/self-preserving per their own justifications; mkfs_format_run explicitly preserves every callee-save register it touches (design/architecture.md §7) -- so rbx/r14/r15 all survive every call in this function transparently, needing no push/pop here. No `add reg,[mem]`; every zero-check is cmp reg, 0 (no `test` mnemonic). Labels prefixed mkfs_main_.",
      block: {
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Phase 1: parse argv. ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + mkfs_argv_out];
        call argv_parse;

        cmp rax, 0;                          // ARGV_OK
        je mkfs_main_argv_ok;

        // ---- ARGV_ERR_MISSING_TARGET ---------------------------------------
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_missing_target];
        mov rdx, 27;                         // mkfs_msg_missing_target_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_argv_ok:
        lea r14, [rip + mkfs_argv_out];      // r14 = &ParsedArgv

        mov rbx, [r14 + 0];                  // rbx = flags (Argv::PA_OFF_FLAGS)
        mov r15, [r14 + 32];                 // r15 = target_ptr (Argv::PA_OFF_TARGET_PTR)

        // ---- Gate 1: target classifies as TARGET_FILE (0)? Unconditional
        //      on --dry-run -- a device-cap/invalid target is "not yet
        //      implemented" either way (mkfs.pdxfs.M3-001). --------------
        mov rdi, r15;
        call target_classify;
        cmp rax, 0;                          // Target::TARGET_FILE
        jne mkfs_main_not_implemented;

        // ---- Gate 2: --dry-run set? (Argv::PA_FLAG_DRY_RUN = 0x2) ---------
        mov rax, rbx;
        and rax, 0x2;
        cmp rax, 0;
        je mkfs_main_file_real;

        // ---- --dry-run + TARGET_FILE: unchanged M1 preview path. ----------
        mov rdi, r15;                        // target_ptr
        mov rsi, [r14 + 8];                  // label_ptr (Argv::PA_OFF_LABEL_PTR)
        mov rdx, [r14 + 16];                 // journal_size (Argv::PA_OFF_JOURNAL_SIZE)
        call format_record_emit_dry_run;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_file_real:
        // ---- M2 (#4/#5/#6/#7): the real write pipeline. -------------------
        mov rdi, r15;                        // target_ptr
        mov rax, rbx;
        and rax, 0x1;                        // Argv::PA_FLAG_FORCE
        mov rsi, rax;                        // force_flag (0 or 1)
        mov rdx, [r14 + 16];                 // journal_size (blocks)
        call mkfs_format_run;

        mov rdi, rax;                        // exit status returned verbatim
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_not_implemented:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_not_implemented];
        mov rdx, 32;                         // mkfs_msg_not_implemented_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 1;                          // status = 1
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    }
}

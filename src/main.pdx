// src/main.pdx — mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3) — _start
//
// mkfs.pdxfs is a standalone ring-3 ELF, not a library: this file is
// its `_start` entry point, argv-wired per the frozen execve ABI
// (design/user/execve-abi.md in the paideia-os monorepo):
//
//   rdi = argc, rsi = argv (VA of a char*[], own-address-space
//   pointers -- no walker or syscall needed to dereference argv[i]),
//   rdx = envp (unused by this tool), rsp % 16 == 0 at entry.
//
// M1 flow (mkfs.pdxfs.M1-003, issue #3):
//
//   1. Parse argv via Argv::argv_parse (src/argv.pdx, #2). On
//      ARGV_ERR_MISSING_TARGET, print a usage diagnostic to fd 2 and
//      exit 2 (matches design/tooling/volume-tooling-ux.md §3.2's
//      "Any other prefix is a parse error (exit 2, invalid argument)"
//      convention -- a missing positional is the same class of misuse).
//   2. If --dry-run is set AND Target::target_classify (src/target.pdx)
//      says the target is TARGET_FILE: call
//      FormatRecord::format_record_emit_dry_run (src/format_record.pdx,
//      #3) to print the PdxFsFormatRecord@0.1 line, then exit 0.
//   3. Otherwise (no --dry-run, or a device-cap / invalid target): print
//      "mkfs.pdxfs: not yet implemented\n" to fd 2 and exit 1 -- the
//      real write path (file-backed superblock write, device-cap
//      resolution + signing) lands at mkfs.pdxfs.M2 / M3 per
//      design/tooling/volume-tooling-ux.md §9.1. This collapses BOTH
//      "no --dry-run" and "--dry-run against a non-file target" into
//      the same not-yet-implemented branch -- mkfs.pdxfs.M1-003's own
//      acceptance text scopes the dry-run happy path to file targets
//      only ("If --dry-run set AND target parses as a file path"), and
//      a --dry-run device-cap invocation has no real target-taxonomy
//      resolution to preview yet (that is mkfs.pdxfs.M3-001), so it is
//      not meaningfully different from the real-write path being absent.
//
// ----------------------------------------------------------------------
// Register plan
// ----------------------------------------------------------------------
//
// All callee-save (SysV rbx/r12-r15), so they survive the three nested
// `call`s (argv_parse, target_classify, format_record_emit_dry_run)
// without any push/pop -- each callee clobbers only caller-save
// registers per its own justification, and SYSCALL preserves callee-
// save registers by the amd64 fast-syscall convention:
//
//   r12 = argc (saved immediately from rdi, before any call)
//   r13 = argv (saved immediately from rsi)
//   r14 = &mkfs_argv_out (the ParsedArgv scratch struct, lea'd once)
//   rbx = ParsedArgv.flags (loaded once after argv_parse succeeds)
//   r15 = ParsedArgv.target_ptr (loaded once after argv_parse succeeds)
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `mkfs_main_`.
//
// SC+ IDs used (same frozen ordinals every src/user/*.pdx binary in the
// paideia-os monorepo uses): 1 = sys_write(fd, buf, count), 60 =
// sys_exit(status).
//
// Upstream: design/tooling/volume-tooling-ux.md §3 (paideia-os);
// design/user/execve-abi.md (paideia-os, the frozen argv ABI this
// _start consumes).

module Main = structure {

  // --- ParsedArgv scratch struct (Argv::PA_STRUCT_BYTES = 40 bytes). ------
  // .bss, zero-initialised by the loader before _start runs; argv_parse
  // additionally writes every field explicitly (including the
  // journal_size default) so this function never reads stale/uninit
  // bytes even on a build where .bss zero-init were somehow skipped.
  pub let mut mkfs_argv_out : [u8; 40] = uninit @align(8)

  // --- Diagnostic messages (fd 2). -----------------------------------------
  pub let mkfs_msg_missing_target     : [u8; 28] = "mkfs.pdxfs: missing target\n\0"
  pub let mkfs_msg_missing_target_len : u64 = 27

  pub let mkfs_msg_not_implemented     : [u8; 33] = "mkfs.pdxfs: not yet implemented\n\0"
  pub let mkfs_msg_not_implemented_len : u64 = 32

  // ==========================================================================
  // _start -- user program entry point. Never returns (every terminal
  // path ends in sys_exit).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mkfs.pdxfs.M1-001 (scaffold) + M1-003 (#3): mkfs.pdxfs _start. Stashes argc (rdi) into r12 and argv (rsi) into r13 immediately (both SysV callee-save) so they survive the `call argv_parse` below. Phase 1: rdi=r12, rsi=r13, rdx=&mkfs_argv_out (rip-relative lea), call argv_parse (src/argv.pdx, #2). On a non-zero return (ARGV_ERR_MISSING_TARGET), jump to mkfs_main_missing_target: sys_write(2, mkfs_msg_missing_target, 27), sys_exit(2) -- exit code 2 matches design/tooling/volume-tooling-ux.md §3.2's 'parse error (exit 2, invalid argument)' convention for a malformed invocation, extended here to cover a missing positional as the same misuse class. Phase 2 (on ARGV_OK): r14 = &mkfs_argv_out (rip-relative lea, held for the rest of _start); rbx = [r14+0] (ParsedArgv.flags, Argv::PA_OFF_FLAGS); r15 = [r14+32] (ParsedArgv.target_ptr, Argv::PA_OFF_TARGET_PTR). Gate 1: rax = rbx & 0x2 (Argv::PA_FLAG_DRY_RUN); cmp rax, 0; je mkfs_main_not_implemented when --dry-run was not given. Gate 2: rdi = r15; call target_classify (src/target.pdx); cmp rax, 0 (Target::TARGET_FILE); jne mkfs_main_not_implemented when the target is not a plain file path (device-cap or invalid prefix -- mkfs.pdxfs.M1-003's dry-run happy path is scoped to file targets only per its own acceptance text). Both gates passing: rdi = r15 (target_ptr), rsi = [r14+8] (ParsedArgv.label_ptr, Argv::PA_OFF_LABEL_PTR, 0 if unset), rdx = [r14+16] (ParsedArgv.journal_size, Argv::PA_OFF_JOURNAL_SIZE, already defaulted by argv_parse); call format_record_emit_dry_run (src/format_record.pdx, #3) -- prints the PdxFsFormatRecord@0.1 line to fd 1. Then sys_exit(0). mkfs_main_not_implemented: sys_write(2, mkfs_msg_not_implemented, 32), sys_exit(1) -- covers both 'no --dry-run' (the real write path is mkfs.pdxfs.M2/M3, not yet implemented) and '--dry-run against a non-file target' (target-taxonomy resolution for device-cap targets is mkfs.pdxfs.M3-001). Every terminal path ends in sys_exit (never returns); a trailing hlt on each path is defensive belt-and-suspenders for the impossible fallthrough, matching every other _start in the paideia-os monorepo's src/user/ tree. No `add reg,[mem]`; every zero-check is cmp reg, 0 (no `test` mnemonic). Labels prefixed mkfs_main_.",
      block: {
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Phase 1: parse argv. ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        lea rdx, [rip + mkfs_argv_out];
        call argv_parse;

        cmp rax, 0;                          // ARGV_OK
        je mkfs_main_argv_ok;

        // ---- ARGV_ERR_MISSING_TARGET ---------------------------------------
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_missing_target];
        mov rdx, 27;                         // mkfs_msg_missing_target_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 2;                          // status = 2 (invalid argument)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_argv_ok:
        lea r14, [rip + mkfs_argv_out];      // r14 = &ParsedArgv

        mov rbx, [r14 + 0];                  // rbx = flags (Argv::PA_OFF_FLAGS)
        mov r15, [r14 + 32];                 // r15 = target_ptr (Argv::PA_OFF_TARGET_PTR)

        // ---- Gate 1: --dry-run set? (Argv::PA_FLAG_DRY_RUN = 0x2) ---------
        mov rax, rbx;
        and rax, 0x2;
        cmp rax, 0;
        je mkfs_main_not_implemented;

        // ---- Gate 2: target classifies as TARGET_FILE (0)? -----------------
        mov rdi, r15;
        call target_classify;
        cmp rax, 0;                          // Target::TARGET_FILE
        jne mkfs_main_not_implemented;

        // ---- Both gates passed: emit the dry-run format record. -----------
        mov rdi, r15;                        // target_ptr
        mov rsi, [r14 + 8];                  // label_ptr (Argv::PA_OFF_LABEL_PTR)
        mov rdx, [r14 + 16];                 // journal_size (Argv::PA_OFF_JOURNAL_SIZE)
        call format_record_emit_dry_run;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkfs_main_not_implemented:
        mov rdi, 2;                          // fd = stderr
        lea rsi, [rip + mkfs_msg_not_implemented];
        mov rdx, 32;                         // mkfs_msg_not_implemented_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, 1;                          // status = 1
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    }
}

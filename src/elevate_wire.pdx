// src/elevate_wire.pdx — mkfs.pdxfs.M3-005 (#12) — libpdx-elevate
// KIND_BLOCK_DEVICE(write) elevation request for device targets.
//
// ----------------------------------------------------------------------
// The API this issue assumes does not exist -- what libpdx-elevate
// actually offers
// ----------------------------------------------------------------------
//
// This issue's own task text describes calling
// `elevate_client_require(RESOURCE_KIND=KIND_BLOCK_DEVICE, action=WRITE,
// target=<dev_slot>)`. A full read of `libpdx-elevate`'s real, mature
// (4844 LOC) source finds NO such function shape anywhere: there is no
// `RESOURCE_KIND`/`action` vocabulary, no `KIND_BLOCK_DEVICE`- or
// `KIND_BLKDEV`-specific entry point, and "target" is never a device
// slot or URI. The library's real model is a capability-BITMASK handle,
// opaque to the library itself:
//
//   elevate_client_acquire(caps, dur, req_buf, reply_ep_id, reply_buf,
//                           mint_ctx_buf) -> row_id (u64, <16) | error
//     -- mints a new elevation "row" via a broker request. REQUIRES the
//        caller to already hold a KIND_IPC_ENDPOINT cap over the
//        elevate broker at `mint_ctx_buf`'s `parent_ep_slot` field --
//        `libpdx-elevate`'s own caps.decl/README are explicit that this
//        prerequisite cap is "declared by whatever the caller links this
//        library into, not by libpdx-elevate" itself.
//   elevate_client_require(row_id, needed_caps) -> ELCA_OK (0) |
//     ELCA_ERR_EXPIRED | ELCA_ERR_CAPS_INSUFFICIENT | ...
//     -- checks an ALREADY-ACQUIRED row's bitmask against `needed_caps`.
//        Takes a `row_id` (a handle into a 16-slot in-process table this
//        SAME process populated via `elevate_client_acquire`), never a
//        resource kind, action, or target device.
//
// `mkfs.pdxfs` has no `parent_ep_slot` -- this repo's own `caps.decl`
// (M1 landing) declares `KIND_ELEVATE_CHANNEL = 0x191` as a PLACEHOLDER
// only, "not declared as a consumed kind at M1: no code path in this
// landing calls libpdx-elevate" -- unchanged by this M3 landing, since
// no design doc or osarch coordination point has since minted mkfs.pdxfs
// a real broker endpoint cap to acquire from. Without that cap, this
// file cannot construct a real `elevate_client_acquire` call at all --
// there is no `req_buf`/`mint_ctx_buf` this repo could honestly fill in
// with a target_cap_kind/target_cap_rights pair meaning "KIND_BLKDEV,
// write", because `libpdx-elevate` treats both of those fields as
// opaque values "declared by whatever the caller links this library
// into" (its own README's own wording) -- and no such declaration has
// been coordinated with osarch for mkfs.pdxfs's device-cap path (see
// design/architecture.md §6's still-unresolved KIND_BLKDEV/
// KIND_BLOCK_DEVICE naming note, which this same gap blocks on).
//
// ----------------------------------------------------------------------
// Fail-closed: DENY is the only reachable outcome at M3
// ----------------------------------------------------------------------
//
// Rather than fabricate a plausible-looking `elevate_client_acquire`/
// `elevate_client_require` call sequence against fields this repo cannot
// honestly populate (which would look real without being real -- the
// same trap `src/pipe_wire.pdx`'s own module header documents avoiding
// for the semantic-pipe schema-hash question), `mkfs_elev_require_
// device_write` always returns `MKFS_ELEV_DENY`. This is not a
// fabricated denial of a request that was never sent -- it is this
// file's own honest, fail-closed answer to "can this process prove it
// holds write elevation over this block device": since no real
// elevation request can be constructed at all (the broker-endpoint
// prerequisite above), "cannot prove GRANT" and "DENY" are the same
// externally observable outcome, and this repo's security posture
// (matching `src/refusal.pdx`'s own non-blank-target refusal discipline)
// treats an unprovable claim as a denial rather than an implicit grant.
//
// `src/main.pdx`'s device-target dispatch therefore ALWAYS takes the
// `FormatRecord::FR_RESULT_ELEVATION_DENIED` exit for a `cap:blkdev:`
// target at this landing (see that file's own header). The `MKFS_ELEV_
// GRANT` return value and the GRANT arm of the caller's dispatch are
// real, wired code paths -- not dead code removed for tidiness -- kept
// so the day a real broker-endpoint cap and a resolved
// target_cap_kind/target_cap_rights pair exist (see design/
// architecture.md §11 for the exact follow-up chain), only this
// function's BODY needs to change to a real `elevate_client_acquire` +
// `elevate_client_require` sequence -- no caller-side change.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic. Reserved-label
// discipline: every branch label in this file is prefixed `mkfs_elev_`.
//
// Upstream: paideia-satellites/libpdx-elevate (README.md "Callers"
// section, src/elevate_client_acquire.pdx, src/elevate_client_require.pdx);
// design/tooling/volume-tooling-ux.md §2.1 (paideia-os, KIND_ELEVATE_
// CHANNEL); this repo's own caps.decl (M1 landing, KIND_ELEVATE_CHANNEL
// placeholder note, unchanged by this file).

module ElevateWire = structure {

  // --- mkfs_elev_require_device_write return values. ---------------------
  pub let MKFS_ELEV_DENY  : u64 = 0
  pub let MKFS_ELEV_GRANT : u64 = 1

  // ==========================================================================
  // mkfs_elev_require_device_write(target_ptr, dev_slot) -> u64
  //   (MKFS_ELEV_DENY | MKFS_ELEV_GRANT -- see module header: DENY is the
  //   only value this landing's body can ever produce)
  //
  //   rdi = target_ptr  (the full "cap:blkdev:0xNN" string; unused by
  //                       this landing's body -- kept as a parameter so a
  //                       future real body has it available without an
  //                       ABI change, since a real elevate_client_acquire
  //                       call would need it for audit/logging context)
  //   rsi = dev_slot     (the parsed device-cap slot number,
  //                       src/target.pdx's mkfs_dev_parse_slot output;
  //                       unused by this landing's body for the same
  //                       reason)
  //
  // Pure leaf, no branches, no nested call, no push/pop.
  // ==========================================================================
  pub let mkfs_elev_require_device_write : (u64, u64) -> u64 !{} @{} =
    fn (target_ptr: u64) (dev_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "mkfs.pdxfs.M3-005 (#12): mkfs_elev_require_device_write entry point. target_ptr (rdi) and dev_slot (rsi) are accepted but READ BY NOTHING in this landing's body -- see module header for why no real elevate_client_acquire/elevate_client_require call can be honestly constructed yet (no broker-endpoint cap, no resolved target_cap_kind/target_cap_rights pair). `mov rax, 0` (MKFS_ELEV_DENY) unconditionally; `ret`. Pure leaf -- no push/pop, no `add reg,[mem]`, no `test`. Labels prefixed mkfs_elev_ (none needed -- no branch).",
      block: {
        mov rax, 0;                          // MKFS_ELEV_DENY (fail-closed; see module header)
        ret;
      }
    }
}

// src/encrypt.pdx -- mkfs.pdxfs.LV11-025 (#25) -- --encrypt / --passphrase-fd
// format-time wiring around libpdx-volume M5-001/M5-002 (#29, #30)
//
// ----------------------------------------------------------------------
// Scope
// ----------------------------------------------------------------------
//
// This file lands the two hook bodies src/format.pdx's mkfs_format_run
// invokes when the caller's ParsedArgv carries PA_FLAG_ENCRYPT:
//
//   mkfs_encrypt_apply_flag(summary_ptr, flags) -> ()
//     Called BEFORE pdxb_encode_superblock. Iff `flags & PA_FLAG_ENCRYPT`
//     (0x80), bumps the summary's version to PDXB_VERSION_V2 via
//     pdxb_sb_set_version and OR-s PDXB_FLAG_ENCRYPTED (0x02) into
//     SBS_OFF_FLAGS via a get_flags/set_flags pair. When the bit is not
//     set the function returns immediately without touching the summary
//     -- an M2/M3-shape invocation flows through with no observable
//     change. Idempotent: calling it twice on the same summary produces
//     the same result as calling it once.
//
//   mkfs_encrypt_apply_wrap(encoded_sb_ptr, passphrase_fd) -> rc
//     Called AFTER pdxb_encode_superblock and BEFORE pdxb_sign_superblock,
//     only when the caller has already gated on PA_FLAG_ENCRYPT (this
//     function is not itself flag-gated -- an unconditional invocation
//     would perform the KDF work even when encryption is disabled).
//     Reads up to LPV_PASSPHRASE_MAX_BYTES (256) bytes of passphrase
//     from `passphrase_fd` via a real sys_read, derives a KEK through
//     libpdx-volume's pdxb_kek_derive (Argon2id, 64 MiB / 3 / 1 per
//     LPV_ARGON2_*), wraps a placeholder all-zero 32-byte DEK through
//     pdxb_dek_wrap under a placeholder all-zero 12-byte nonce and a
//     placeholder all-zero 16-byte KDF salt, and stamps the resulting
//     wrapped_dek / kdf_salt / wrap_nonce into the on-disk buffer at
//     their PDXB_D_OFF_* offsets (192 / 240 / 256) via the LV.M5-002
//     accessor family plus one 12-byte direct store. Returns 0 on
//     success or the raw libpdx-volume error code (LPV_CRYPTO_ERR_*,
//     0x09xx band) on any KDF/AEAD failure -- mkfs_format_run pipes
//     that code into the FAIL record's `error: <n>` slot.
//
// ----------------------------------------------------------------------
// Placeholder-material posture (documented, deliberate)
// ----------------------------------------------------------------------
//
// The wire fields this function stamps are produced by REAL calls into
// libpdx-volume's crypto intrinsics (Argon2id + XChaCha20-Poly1305 or
// whatever pdxb_crypto_seal_raw binds today), so the ciphertext + tag
// bytes at offset 192 are a genuine, verifiable AEAD sealing of the
// 32-byte DEK under the passphrase-derived KEK. What is NOT real yet:
//
//   1. **DEK entropy.** The kernel exposes no `sys_random` /
//      `sys_getrandom` primitive at any sysno (grep-verified against
//      design/user/syscall-table.md, refreshed through sysno 107 plus
//      the out-of-band 517/527). Rather than fabricate entropy from
//      /dev/urandom-style pseudo-files that also do not exist yet, this
//      landing uses a placeholder all-zero 32-byte DEK held in the
//      permanently-zero .bss buffer `mkfs_encrypt_dek_zero`, matching
//      src/format.pdx's `mkfs_sign_seed_zero` precedent EXACTLY.
//      Documented gap for a future R-wave: a real sys_getrandom, or a
//      KIND_KEK-mediated DEK-mint path (paideia-os #2224 landed the
//      cap kind but no sys_kek_dek_mint syscall yet).
//
//   2. **KDF salt entropy.** Same story: `mkfs_encrypt_salt_zero` is a
//      permanently-zero 16-byte scratch that stands in as the salt
//      argument to pdxb_kek_derive. A deterministic salt collapses
//      Argon2id's rainbow-table-resistance property -- two invocations
//      with the same passphrase produce the SAME KEK, which is fine
//      for a wire-format demonstration but MUST be replaced with a
//      real random salt (persisted into wrap_nonce/kdf_salt on disk)
//      before this tool ships against real user data.
//
//   3. **Wrap nonce.** Same shape: `mkfs_encrypt_nonce_zero` is a
//      permanently-zero 12-byte scratch. A fixed nonce with a fixed
//      DEK collapses the AEAD's key-committing security; the wire
//      bytes at offsets 240..268 (kdf_salt+wrap_nonce) are a genuine
//      byte-for-byte record of what this run passed to
//      pdxb_dek_wrap, so a future entropy-wired revision produces
//      wire-visible diffs against this landing.
//
// Every one of these is exactly the same posture src/format.pdx's
// "Seed-key strategy: placeholder all-zero seed, real loading deferred"
// section documents for ML-DSA-65 signing. The v1.1 wire format lands
// here; the entropy substrate is a separate future gap.
//
// ----------------------------------------------------------------------
// Missing libpdx-volume accessor (flagged for main)
// ----------------------------------------------------------------------
//
// libpdx-volume v1.1.1 (LV.M5-002, #30) exposes `pdxb_sb_get_wrapped_dek`
// / `pdxb_sb_set_wrapped_dek` and `pdxb_sb_get_kdf_salt` / `pdxb_sb_set_
// kdf_salt` for the two aligned slots, plus the constant
// `PDXB_D_OFF_WRAP_NONCE = 256` and `PDXB_WRAP_NONCE_BYTES = 12` for the
// 12-byte wrap_nonce field -- but NO `pdxb_sb_get_wrap_nonce` /
// `pdxb_sb_set_wrap_nonce` accessor pair. This landing therefore
// writes the wrap_nonce via one direct qword store at [encoded+256]
// (all 8 bytes) followed by one direct dword store at [encoded+264]
// (the last 4 bytes) -- the same shape libpdx-volume's own
// pdxb_sb_set_wrapped_dek uses internally for its six-qword copy, but
// spelled out here because the accessor pair is not exported.
//
// **Flagged for main and for libpdx-volume:** add the two missing
// `pdxb_sb_get_wrap_nonce` / `pdxb_sb_set_wrap_nonce` accessors to
// libpdx-volume/src/pdxb_superblock.pdx so this file's direct-offset
// store can be swapped for a symmetric accessor call.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `@no_frame` anywhere (frame prologue implicit). No `add reg, [mem]`
// anywhere. No `test` mnemonic; every zero-check is `cmp reg, 0`.
// Reserved-label discipline: every branch label prefixed
// `mkfs_encrypt_`.
//
// SC+ IDs used (design/user/syscall-table.md paideia-os, refreshed
// through sysno 107): 0 = sys_read.

module Encrypt = structure {

  // --- LV11-025 (#25) flag bit masks, mirrored from src/argv.pdx per
  //     this codebase's comment-citing convention (paideia-as does not
  //     resolve cross-file `pub let` bindings as inline immediates). --
  pub let MKFS_ENC_FLAG_ENCRYPT : u64 = 0x80    // PA_FLAG_ENCRYPT
  pub let MKFS_ENC_FLAG_QUOTA   : u64 = 0x200   // PA_FLAG_QUOTA_SET

  // --- PDXB v2 constants, cited from libpdx-volume/src/pdxb_superblock.pdx
  //     and libpdx-volume/src/pdxb_crypto.pdx respectively. -----------
  pub let PDXB_VERSION_V2         : u64 = 2       // libpdx-volume
  pub let PDXB_FLAG_ENCRYPTED     : u64 = 0x02    // libpdx-volume flags bit
  pub let PDXB_D_OFF_WRAP_NONCE   : u64 = 256     // libpdx-volume on-disk offset
  pub let PDXB_WRAP_NONCE_BYTES   : u64 = 12      // libpdx-volume nonce length
  pub let LPV_KEK_LEN             : u64 = 32
  pub let LPV_PASSPHRASE_MAX_BYTES : u64 = 256

  // --- LV11-025 (#25) placeholder crypto material. Every one of these
  //     is a permanently-zero .bss reserve stamping the same posture
  //     src/format.pdx's mkfs_sign_seed_zero uses for ML-DSA-65
  //     signing. See this file's module header for the documented gap
  //     these placeholders leave for a future entropy-substrate wave.
  pub let mut mkfs_encrypt_dek_zero    : [u8; 32]  = uninit @align(8)  // LPV_DEK_LEN
  pub let mut mkfs_encrypt_salt_zero   : [u8; 16]  = uninit @align(8)  // LPV_KDF_SALT_LEN
  pub let mut mkfs_encrypt_nonce_zero  : [u8; 16]  = uninit @align(8)  // LPV_AEAD_NONCE_LEN (12 B stored; 4 B pad kept for qword alignment)
  pub let mut mkfs_encrypt_kek_scratch : [u8; 32]  = uninit @align(8)  // LPV_KEK_LEN, written by pdxb_kek_derive
  pub let mut mkfs_encrypt_wrapped_out : [u8; 48]  = uninit @align(8)  // LPV_WRAPPED_DEK_LEN (32 ct + 16 tag)
  pub let mut mkfs_encrypt_pass_buf    : [u8; 256] = uninit @align(8)  // LPV_PASSPHRASE_MAX_BYTES

  // --- LV11-025 (#25) passphrase-read len stash. sys_read's return
  //     value is a positive byte count on success or a negative errno
  //     on failure; we hold it in a .bss slot rather than a register
  //     since the next call (pdxb_kek_derive) shuffles rdi/rsi/rdx
  //     around and would otherwise force us to burn a callee-save
  //     register for a single scalar. -----------------------------------
  pub let mut mkfs_encrypt_pass_len : u64 = uninit @align(8)

  // ==========================================================================
  // mkfs_encrypt_apply_flag(summary_ptr, flags) -> ()
  //
  //   rdi = summary_ptr (176-byte PdxbSuperblockSummary, SBS_OFF_* layout)
  //   rsi = flags       (ParsedArgv.flags verbatim)
  //
  // Iff `flags & PA_FLAG_ENCRYPT` (0x80), bumps the summary's version
  // to PDXB_VERSION_V2 (via pdxb_sb_set_version) and OR-s
  // PDXB_FLAG_ENCRYPTED (0x02) into SBS_OFF_FLAGS (via a
  // pdxb_sb_get_flags -> or -> pdxb_sb_set_flags round trip). No-op
  // when the bit is not set.
  //
  // Register plan: rbx = summary_ptr, r12 = flags. Both callee-save,
  // pushed on entry and popped before the single ret -- required
  // because the three nested libpdx-volume accessor calls each
  // clobber rax/rdi/rsi (all caller-save under SysV). r13 is
  // additionally pushed/popped in mkfs.pdxfs 1.1.1 fixup (Bug #3) as
  // a throwaway third slot for rsp%16==0 stack alignment across the
  // nested `call` sites -- SysV entry hands us rsp%16==8, so an odd
  // number of pushes (three) restores rsp%16==0 as the callees expect.
  // ==========================================================================
  pub let mkfs_encrypt_apply_flag : (u64, u64) -> () !{mem} @{} =
    fn (summary_ptr: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mkfs.pdxfs.LV11-025 (#25) + 1.1.1 fixup (Bug #3): mkfs_encrypt_apply_flag entry point. push rbx; push r12; push r13 before repurposing either -- r13 is a throwaway third push whose ONLY role is to keep rsp % 16 == 0 across the three nested pdxb_sb_* calls (SysV entry hands us rsp % 16 == 8; two callee-save pushes would leave rsp % 16 == 8 which is a stack-misalignment ABI violation at every call site even though the pdxb_sb_get_flags/_set_flags/_set_version leaves currently tolerate it; three pushes restore rsp % 16 == 0, matching mkfs_encrypt_apply_wrap's own rbx/r12/r13 push shape in this file). r13 itself is never read, only stored back to on the epilogue pop. rbx = summary_ptr, r12 = flags. Flag gate: `mov rax, r12; and rax, 0x80` (PA_FLAG_ENCRYPT / MKFS_ENC_FLAG_ENCRYPT); `cmp rax, 0; je done` skips the whole body when the bit is not set. On the encrypt path: (1) pdxb_sb_set_version(rbx, 2=PDXB_VERSION_V2) via `mov rdi, rbx; mov rsi, 2; call pdxb_sb_set_version`. (2) pdxb_sb_get_flags(rbx) via `mov rdi, rbx; call pdxb_sb_get_flags` -> rax = current flags. (3) OR the encrypt bit: `mov r10, rax; or r10, 0x02` (PDXB_FLAG_ENCRYPTED -- imm8, no r11 staging). (4) pdxb_sb_set_flags(rbx, r10) via `mov rdi, rbx; mov rsi, r10; call pdxb_sb_set_flags`. done: pop r12; pop rbx; ret. Every nested call is a pure leaf (pdxb_sb_get_flags / _set_flags / _set_version per their own libpdx-volume/src/pdxb_superblock.pdx justifications), so rbx/r12 survive each call transparently. No `add reg,[mem]`. No `test`. Labels prefixed mkfs_encrypt_af_. Frame prologue implicit.",
      block: {
        push rbx;
        push r12;
        push r13;                           // 1.1.1 Bug #3: throwaway third push for rsp%16==0

        mov rbx, rdi;                       // rbx = summary_ptr
        mov r12, rsi;                       // r12 = flags

        mov rax, r12;
        and rax, 0x80;                      // MKFS_ENC_FLAG_ENCRYPT
        cmp rax, 0;
        je mkfs_encrypt_af_done;

        // ---- Bump version to v2. -----------------------------------------
        mov rdi, rbx;
        mov rsi, 2;                         // PDXB_VERSION_V2
        call pdxb_sb_set_version;

        // ---- OR the encrypted flag bit into SBS_OFF_FLAGS. --------------
        mov rdi, rbx;
        call pdxb_sb_get_flags;
        mov r10, rax;
        or r10, 0x02;                       // PDXB_FLAG_ENCRYPTED

        mov rdi, rbx;
        mov rsi, r10;
        call pdxb_sb_set_flags;

      mkfs_encrypt_af_done:
        pop r13;                            // 1.1.1 Bug #3: matches the entry push_r13
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // mkfs_encrypt_apply_wrap(encoded_sb_ptr, passphrase_fd) -> u64
  //   (0 on success, or a libpdx-volume LPV_CRYPTO_ERR_* code in the
  //   0x09xx band on any KDF/AEAD failure -- see this file's module
  //   header for the FAIL-record routing)
  //
  //   rdi = encoded_sb_ptr  (4096-byte on-disk superblock image already
  //                           populated by pdxb_encode_superblock)
  //   rsi = passphrase_fd   (fd number the caller opened; ownership is
  //                           NOT taken -- caller closes)
  //
  // The pipeline: sys_read passphrase from fd -> pdxb_kek_derive under
  // placeholder salt -> pdxb_dek_wrap of placeholder DEK under
  // placeholder nonce -> pdxb_sb_set_wrapped_dek + pdxb_sb_set_kdf_salt
  // + direct wrap_nonce store at PDXB_D_OFF_WRAP_NONCE (256).
  //
  // Register plan: rbx = encoded_sb_ptr, r12 = passphrase_fd, r13 =
  // scratch for the passphrase-read return value. All three callee-save,
  // pushed on entry and popped before the shared epilogue.
  // ==========================================================================
  pub let mkfs_encrypt_apply_wrap : (u64, u64) -> u64 !{mem, sysreg, crypto} @{fs, paideia.crypto} =
    fn (encoded_sb_ptr: u64) (passphrase_fd: u64) -> unsafe {
      effects: {mem, sysreg, crypto}, capabilities: {fs, paideia.crypto},
      justification: "mkfs.pdxfs.LV11-025 (#25): mkfs_encrypt_apply_wrap entry point. push rbx; push r12; push r13 before repurposing any. rbx = encoded_sb_ptr, r12 = passphrase_fd, r13 = scratch. Phase 1 (sys_read passphrase): sys_read(rdi=r12, rsi=&mkfs_encrypt_pass_buf, rdx=256=LPV_PASSPHRASE_MAX_BYTES, rax=0 SC+ ID); `cmp rax, 0; jl read_fail` -- a negative return is a genuine sys_read errno failure; we surface it as LPV_CRYPTO_ERR_KDF_FAIL (0x0902) since the KDF cannot proceed without a passphrase and no LPV_* code exists for 'passphrase not readable'. On success (rax >= 0): store rax into mkfs_encrypt_pass_len for pdxb_kek_derive's second argument. Phase 2 (KDF): pdxb_kek_derive(rdi=&mkfs_encrypt_pass_buf, rsi=[mkfs_encrypt_pass_len], rdx=&mkfs_encrypt_salt_zero (placeholder salt), rcx=16=LPV_KDF_SALT_LEN, r8=&mkfs_encrypt_kek_scratch) -> rax=0 on success or LPV_CRYPTO_ERR_KDF_FAIL. `cmp rax, 0; jne wrap_fail` (return rax unchanged, matching this function's contract that any non-zero return propagates verbatim as the FAIL-record errno). Phase 3 (AEAD wrap): pdxb_dek_wrap(rdi=&mkfs_encrypt_kek_scratch, rsi=&mkfs_encrypt_dek_zero, rdx=&mkfs_encrypt_nonce_zero, rcx=&mkfs_encrypt_wrapped_out) -> rax=0 on success or LPV_CRYPTO_ERR_AEAD_FAIL. `cmp rax, 0; jne wrap_fail`. Phase 4 (stamp wrapped_dek): pdxb_sb_set_wrapped_dek(rdi=rbx, rsi=&mkfs_encrypt_wrapped_out) -- libpdx-volume/src/pdxb_superblock.pdx accessor writes 48 bytes at [rbx+192, rbx+240). Phase 5 (stamp kdf_salt): pdxb_sb_set_kdf_salt(rdi=rbx, rsi=&mkfs_encrypt_salt_zero) -- writes 16 bytes at [rbx+240, rbx+256). Phase 6 (stamp wrap_nonce via direct offset stores -- no libpdx-volume accessor exists for this field, see module header's flagged gap): `mov rax, [rip + mkfs_encrypt_nonce_zero]; mov [rbx + 256], rax` (first 8 bytes at PDXB_D_OFF_WRAP_NONCE); `mov_d rax, [rip + mkfs_encrypt_nonce_zero + 8]; mov_d [rbx + 264], rax` (last 4 bytes -- mov_d truncates the store to 4 bytes per this codebase's G1 sized-store discipline). Success: `xor rax, rax; jmp done`. read_fail: `mov rax, 0x0902` (LPV_CRYPTO_ERR_KDF_FAIL). wrap_fail: return rax unchanged. done: pop r13; pop r12; pop rbx; ret. Every nested call is a pure or self-preserving callee per its own justification (pdxb_kek_derive / pdxb_dek_wrap / pdxb_sb_set_* all touch only caller-save registers), so rbx/r12/r13 survive them transparently. No `add reg,[mem]`. No `test`. Labels prefixed mkfs_encrypt_aw_. Frame prologue implicit.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = encoded_sb_ptr
        mov r12, rsi;                       // r12 = passphrase_fd

        // ---- Phase 1: sys_read passphrase. --------------------------------
        mov rdi, r12;
        lea rsi, [rip + mkfs_encrypt_pass_buf];
        mov rdx, 256;                       // LPV_PASSPHRASE_MAX_BYTES
        xor rax, rax;                       // SC+ ID 0 = sys_read
        syscall;
        cmp rax, 0;
        jl mkfs_encrypt_aw_read_fail;

        mov [rip + mkfs_encrypt_pass_len], rax;

        // ---- Phase 2: derive KEK. -----------------------------------------
        lea rdi, [rip + mkfs_encrypt_pass_buf];
        mov rsi, [rip + mkfs_encrypt_pass_len];
        lea rdx, [rip + mkfs_encrypt_salt_zero];
        mov rcx, 16;                        // LPV_KDF_SALT_LEN
        lea r8,  [rip + mkfs_encrypt_kek_scratch];
        call pdxb_kek_derive;
        cmp rax, 0;
        jne mkfs_encrypt_aw_wrap_fail;

        // ---- Phase 3: AEAD-wrap the placeholder DEK. ---------------------
        lea rdi, [rip + mkfs_encrypt_kek_scratch];
        lea rsi, [rip + mkfs_encrypt_dek_zero];
        lea rdx, [rip + mkfs_encrypt_nonce_zero];
        lea rcx, [rip + mkfs_encrypt_wrapped_out];
        call pdxb_dek_wrap;
        cmp rax, 0;
        jne mkfs_encrypt_aw_wrap_fail;

        // ---- Phase 4: stamp wrapped_dek into on-disk buffer. -------------
        mov rdi, rbx;
        lea rsi, [rip + mkfs_encrypt_wrapped_out];
        call pdxb_sb_set_wrapped_dek;

        // ---- Phase 5: stamp kdf_salt into on-disk buffer. ----------------
        mov rdi, rbx;
        lea rsi, [rip + mkfs_encrypt_salt_zero];
        call pdxb_sb_set_kdf_salt;

        // ---- Phase 6: stamp wrap_nonce (no accessor exists -- see
        //      module header's flagged libpdx-volume gap). ----------------
        mov rax, [rip + mkfs_encrypt_nonce_zero];
        mov [rbx + 256], rax;               // PDXB_D_OFF_WRAP_NONCE + 0
        mov_d rax, [rip + mkfs_encrypt_nonce_zero + 8];
        mov_d [rbx + 264], rax;             // PDXB_D_OFF_WRAP_NONCE + 8

        xor rax, rax;
        jmp mkfs_encrypt_aw_done;

      mkfs_encrypt_aw_read_fail:
        mov rax, 0x0902;                    // LPV_CRYPTO_ERR_KDF_FAIL
        jmp mkfs_encrypt_aw_done;

      mkfs_encrypt_aw_wrap_fail:
        // rax already holds the libpdx-volume error code from KDF or AEAD.

      mkfs_encrypt_aw_done:
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
